{
  // Валидность таблиц контента — issue #22, этап 2. Гоняется job'ом `tables` в content.yml.
  // Только СТРУКТУРНЫЕ правила таблиц, никакого стиля: RU-корпус не подгоняем под стилевой
  // линтер (иначе шум на легитимном markdown). Пробный прогон варианта A на всём src дал 3
  // реальные находки и 0 ложных → выбран markdownlint (а не свой скрипт, вариант B).
  //   MD056 — число колонок таблицы (главная боль: битые таблицы, теряющие ячейки);
  //   MD055 — единый стиль граничных `|`;
  //   MD058 — пустые строки вокруг таблиц (ловит подпись-строку, приклеенную к таблице).
  // Лежит в .github/ и подключается ЯВНО через --config → не автоподхватывается редакторами
  // для всего репозитория (только CI-скоуп по globs ниже).
  "config": {
    "default": false,
    "MD055": true,
    "MD056": true,
    "MD058": true
  },
  "globs": ["src/**/*.md"],
  "noProgress": true
}

---
import '@omnisgm-app/brand/tokens.css';
import '@omnisgm-app/brand/fonts.css'; // self-host @font-face (Spectral/Inter/JetBrains), woff2 в public/fonts/ (#10)
import '@omnisgm-app/brand/base.css';
import '../styles/reader.css';

export interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'ru';
  canonical?: string;
  bilingual?: boolean;   // корень «/»: x-default, автоязык по локали, без редиректа
  titleRu?: string;      // RU-заголовок для свопа document.title при bilingual
  image?: string;        // og:image (путь от корня); по умолчанию /og.png
  jsonLd?: object;       // граф schema.org (Organization/WebSite/BreadcrumbList/Article)
  alternates?: { en: string; ru: string; xDefault: string }; // hreflang-пары (пути от корня) для не-корневых страниц
}
const { title, description = '', lang = 'en', canonical, bilingual = false, titleRu, image = '/og.png', jsonLd, alternates } = Astro.props;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
const ORIGIN = Astro.site ? Astro.site.origin : 'https://rules.omnisgm.com';
// Глоссарные страницы (справочные таблицы-выжимки) выводим из индекса: noindex,follow
// — ссылочный вес продолжает течь по внутренним ссылкам, но сами страницы не конкурируют
// за краул-бюджет с контентными и programmatic-страницами (issue #37). Их же исключаем
// из sitemap (astro.config). robots.txt НЕ трогаем (Disallow скрыл бы сам noindex).
const isGlossary = Astro.url.pathname.includes('/glossary/');
const imageURL = new URL(image, ORIGIN).toString();
const ogLocale = lang === 'ru' ? 'ru_RU' : 'en_US';
const ogAltLocale = lang === 'ru' ? 'en_US' : 'ru_RU';
---
<!DOCTYPE html>
<html lang={lang} data-title-ru={bilingual ? titleRu : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {bilingual && (
      /* Автоязык по локали ДО отрисовки (без редиректа): ru-* → флаг на <html>, CSS показывает RU. */
      <script is:inline>
        (function () {
          try {
            if ((navigator.language || '').toLowerCase().indexOf('ru') === 0) {
              document.documentElement.setAttribute('data-rootlang', 'ru');
              document.documentElement.lang = 'ru';
            }
          } catch (e) {}
        })();
      </script>
    )}
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {isGlossary && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    {/* hreflang-кластер. Взаимоисключающе: корень «/» — через bilingual; остальные страницы — через alternates.
        Google требует взаимности (односторонний hreflang игнорируется) — RU/EN-пара выводит одинаковую тройку. */}
    {bilingual && (
      <>
        <link rel="alternate" hreflang="en" href={`${ORIGIN}/en/`} />
        <link rel="alternate" hreflang="ru" href={`${ORIGIN}/ru/`} />
        <link rel="alternate" hreflang="x-default" href={`${ORIGIN}/`} />
      </>
    )}
    {/* На noindex-глоссарии hreflang-alternates бессмысленны — не выводим. */}
    {!bilingual && !isGlossary && alternates && (
      <>
        <link rel="alternate" hreflang="en" href={`${ORIGIN}${alternates.en}`} />
        <link rel="alternate" hreflang="ru" href={`${ORIGIN}${alternates.ru}`} />
        <link rel="alternate" hreflang="x-default" href={`${ORIGIN}${alternates.xDefault}`} />
      </>
    )}

    {/* Шрифты self-host из бренд-кита (#10): @font-face в @omnisgm-app/brand/fonts.css (импорт выше),
        woff2 в /fonts/ (copy-brand-assets). Google Fonts CDN убран. Preload критичного Inter latin. */}
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    <meta name="theme-color" content="#0F1016" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Растровый ICO для краулеров, плохо понимающих SVG-favicon (Яндекс брал иконку
         только у Table, где /favicon.ico есть; здесь его не было → /favicon.ico давал 404). -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OmnisGM Rules" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogAltLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageURL} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <slot />
    {bilingual && (
      /* RU-адаптация после парса (ссылки/селекты невидимы до клика — мигания нет):
         переписываем /en/ → /ru/ в ссылках и значениях селектов, чиним язык в нативных <option>. */
      <script is:inline>
        (function () {
          if (document.documentElement.getAttribute('data-rootlang') !== 'ru') return;
          var swap = function (s) { return s ? s.replace(/^\/en\//, '/ru/') : s; };
          // ссылки /en/ → /ru/, КРОМЕ переключателя языка (он должен вести именно на /en/)
          document.querySelectorAll('a[href^="/en/"]:not([data-l])').forEach(function (a) {
            a.setAttribute('href', swap(a.getAttribute('href')));
          });
          document.querySelectorAll('select.rd-sysmenu option').forEach(function (o) {
            o.value = swap(o.value);
          });
          // нативные <option> не переключаются CSS — показываем RU-подпись из data-ru, где есть
          document.querySelectorAll('option[data-ru]').forEach(function (o) { o.textContent = o.getAttribute('data-ru'); });
          var ls = document.querySelector('select.rd-lang-sel'); if (ls) ls.value = '/ru/';
          var rt = document.documentElement.getAttribute('data-title-ru'); if (rt) document.title = rt;
        })();
      </script>
    )}
    <script>
      import { initAnalytics } from '../lib/analytics-client';
      // module-скрипт по умолчанию отложен — не блокирует рендер/LCP
      initAnalytics();
    </script>
  </body>
</html>

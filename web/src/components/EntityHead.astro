---
// Шапка страницы сущности с картинкой (#201 — портрет существа, #202 — иконка заклинания
// или магического предмета). Картинка слева от заголовка: крупно на десктопе, компактно
// на мобильном. Без картинки (сущность, для которой генератор ещё не отработал) компонент
// отдаёт заголовок как есть — без пустого места и без сдвига разметки.
export interface Props {
  image?: string | null;  // путь от корня, уже проверенный на существование файла
  alt: string;            // имя сущности
  size?: number;          // сторона исходника, px
}
const { image, alt, size = 512 } = Astro.props;
---

{image ? (
  <div class="ent-head">
    {/* Картинка — в первом экране, поэтому НЕ lazy: ленивая загрузка LCP-картинки
        сама по себе штрафуется Lighthouse. width/height заданы → место
        зарезервировано, CLS не растёт. */}
    <img
      class="ent-portrait"
      src={image}
      alt={alt}
      width={size}
      height={size}
      decoding="async"
      fetchpriority="high"
    />
    <div class="ent-head-title"><slot /></div>
  </div>
) : (
  <slot />
)}

<style>
  .ent-head {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
    margin: 0 0 22px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--og-border);
  }
  .ent-portrait {
    width: 168px; height: 168px;
    display: block;
    border-radius: 12px;
    border: 1px solid var(--og-border);
    background: var(--og-surface-2, #14141a);
  }
  /* Заголовок внутри шапки отдаёт свою черту обёртке — иначе линий было бы две. */
  .ent-head-title :global(h1) {
    margin: 0;
    padding-bottom: 0;
    border-bottom: 0;
  }
  @media (max-width: 720px) {
    .ent-head { grid-template-columns: 92px minmax(0, 1fr); gap: 14px; }
    .ent-portrait { width: 92px; height: 92px; border-radius: 10px; }
  }
</style>

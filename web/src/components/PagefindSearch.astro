---
// Классический `PagefindUI` из `@pagefind/default-ui`. Своя обёртка, а не
// `astro-pagefind/components/Search.astro`: с astro-pagefind 2 тот отдаёт веб-компонент
// `<pagefind-searchbox>` из `@pagefind/component-ui` — другой DOM, на который завязаны
// разметка поиска в `reader.css` и пост-обработка выдачи в `ReaderShell.astro` (#357).
import '@pagefind/default-ui/css/ui.css';
import { join } from 'node:path/posix';

export interface Props {
  readonly id?: string;
  readonly className?: string;
  readonly uiOptions?: Record<string, unknown>;
}

const { id, className, uiOptions = {} } = Astro.props;
const bundlePath = join(import.meta.env.BASE_URL, 'pagefind/');
---

<div
  id={id}
  class:list={[className, 'pagefind-init']}
  data-pagefind-ui
  data-bundle-path={bundlePath}
  data-ui-options={JSON.stringify(uiOptions)}
>
</div>
<script>
  import { PagefindUI } from '@pagefind/default-ui';

  function initPagefind() {
    const allSelector = '[data-pagefind-ui]';
    for (const el of document.querySelectorAll(`${allSelector}.pagefind-init`)) {
      const elSelector = [
        ...(el.id ? [`#${el.id}`] : []),
        ...[...el.classList.values()].map((c) => `.${c}`),
        allSelector,
      ].join('');
      new PagefindUI({
        ...JSON.parse(el.getAttribute('data-ui-options') ?? '{}'),
        element: elSelector,
        bundlePath: el.getAttribute('data-bundle-path'),
      });
      el.classList.remove('pagefind-init');
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPagefind);
  } else {
    initPagefind();
  }
</script>

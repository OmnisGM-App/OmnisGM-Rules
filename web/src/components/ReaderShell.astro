---
import Reader from '../layouts/Reader.astro';
import NavTree from './NavTree.astro';
import I18n from './I18n.astro';
import Search from 'astro-pagefind/components/Search';
import markRaw from '@omnisgm-app/brand/assets/mark.svg?raw';
// Фирменный знак — ЕДИНЫЙ источник из бренд-пакета. Снимаем фикс. размер, масштабируем под контейнер.
const BRAND_MARK = markRaw.replace(/\s(width|height)="[^"]*"/g, '').replace('<svg ', '<svg style="display:block;width:100%;height:100%" ');
import {
  NAV, SYSTEMS, FLAT_PAGES, findPath, systemOf, isGroup, flattenPages,
  label, routeOf, systemRoute, homeRoute, type Lang, type NavGroup, type NavNode,
} from '../lib/nav';

export interface Props {
  lang: Lang;
  currentId: string;          // 'home' или id страницы NAV
  title: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
  sourceId?: string;          // id записи коллекции для ссылки «Источник»
  searchTitle?: string;       // чистый заголовок для индекса Pagefind (иначе берёт h1/документный title)
  bilingual?: boolean;        // корень «/»: рендерим обе подписи, язык — по локали (без редиректа)
  titleRu?: string;           // RU-заголовок (своп document.title при bilingual)
  upLink?: { href: string; ru: string; en: string }; // центр. кнопка «в раздел» в ряду prev/next
  image?: string;        // og:image страницы (портрет существа, #201); по умолчанию общий og.png
  imageWidth?: number;
  imageHeight?: number;
}
const { lang, currentId, title, description, headings = [], sourceId, searchTitle, bilingual = false, titleRu, upLink, image, imageWidth, imageHeight } = Astro.props;
const REPO = 'https://github.com/OmnisGM-App/OmnisGM-Rules';
const REPO_BRANCH = 'main'; // дефолтная ветка репо — для ссылок «Источник»
const MAIN = 'https://omnisgm.com';
// Воронка в лист персонажа: с RU-страниц ведём на русский лендинг omnisgm.com/ru (Table#74),
// чтобы русский посетитель попадал сразу на русский. Билингвальный корень — на «/» (x-default/EN,
// язык там определяется автоматически на стороне лендинга). Table hosting trailingSlash:false → без слэша.
const funnelBase = lang === 'ru' && !bilingual ? `${MAIN}/ru` : `${MAIN}/`;
const t = (ru: string, en: string) => (lang === 'en' ? en : ru);

const activeSys = systemOf(currentId);
const activeSysTab = SYSTEMS.find((s) => s.id === activeSys);
const navRoots = activeSys === 'home' ? NAV : ((NAV.find((n) => n.id === activeSys) as NavGroup)?.kids ?? NAV);

// Атрибуция лицензии в футере — по системе, на каждой контентной странице (требование лицензий:
// CC BY 4.0 для D&D, DPCGL + non-affiliation для Daggerheart, BRP OGL для BRP). На home не показываем.
//
// Строки содержат разметку и рендерятся через set:html — обе лицензии требуют именно ГИПЕРССЫЛКИ,
// а не упоминания: CC BY 4.0 §3(a)(1)(B) — «a URI or hyperlink to the license»; DPCGL §4.1(c) —
// ссылка на сам Public Game Content, §4.1(d) — ссылка на лицензию. Текст здесь наш, не пользовательский.
const ATTRIB: Record<string, { ru: string; en: string }> = {
  dnd: {
    en: 'Includes material from the System Reference Document (SRD 5.2.1 / 5.1) by Wizards of the Coast, licensed under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener license">CC BY 4.0</a>.',
    ru: 'Содержит материалы System Reference Document (SRD 5.2.1 / 5.1) от Wizards of the Coast; лицензия <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener license">CC BY 4.0</a>. Перевод на русский — OmnisGM.',
  },
  daggerheart: {
    // Формула §4.1(a–e) DPCGL: копирайт (a) + точное имя Public Game Content (b) + ссылка на него (c)
    // + ссылка на лицензию (d) + пометка о модификациях (e). Эталонная строка лицензии кончается
    // словами «There are no previous modifications by others» — у нас это не так: EN-текст
    // конвертирован в Markdown с опорой в том числе на стороннюю конверсию, RU — наш перевод.
    // Пишем как есть. (e) требует назвать И свои модификации, И предыдущие чужие, поэтому обе
    // половины стоят прямо здесь: notice каждой страницы самодостаточен и не опирается на то,
    // что читатель перейдёт на «Правовую информацию». Полный разбор — LICENSING-NOTES.md
    // в корне папки OmnisGM.
    en: 'This product includes materials from the Daggerheart System Reference Document 1.0, © Critical Role, LLC. under the terms of the <a href="https://darringtonpress.com/license" target="_blank" rel="noopener license">Darrington Press Community Gaming (DPCGL) License</a>. More information can be found at <a href="https://www.daggerheart.com" target="_blank" rel="noopener">www.daggerheart.com</a>. Converted to Markdown by OmnisGM, in part from an earlier community conversion; the rules text is unchanged. Not affiliated with or endorsed by Darrington Press.',
    ru: 'Этот продукт включает материалы из Daggerheart System Reference Document 1.0, © Critical Role, LLC., на условиях <a href="https://darringtonpress.com/license" target="_blank" rel="noopener license">Darrington Press Community Gaming License (DPCGL)</a>. Подробности — на <a href="https://www.daggerheart.com" target="_blank" rel="noopener">www.daggerheart.com</a>. Текст переведён на русский и конвертирован в Markdown силами OmnisGM, отчасти на основе более ранней сообществной конверсии. Не аффилировано с Darrington Press и не одобрено ей.',
  },
  brp: {
    en: 'Uses the Basic Roleplaying System Reference Document, © Chaosium Inc., under the <a href="https://www.chaosium.com/brp-system-reference-document/" target="_blank" rel="noopener license">BRP Open Game License v1.0</a>.',
    ru: 'Использует Basic Roleplaying System Reference Document, © Chaosium Inc., по <a href="https://www.chaosium.com/brp-system-reference-document/" target="_blank" rel="noopener license">BRP Open Game License v1.0</a>. Перевод на русский — OmnisGM.',
  },
};
const attribution = activeSys !== 'home' ? ATTRIB[activeSys] : undefined;
const legalHref = activeSys !== 'home' ? systemRoute(activeSys, lang) : undefined;

// Открытые группы: предки текущей + на Home по умолчанию раскрываем D&D → SRD 5.2.1
const trail = findPath(currentId) ?? [];
const openIds = new Set(trail.map((n) => n.id));
if (currentId === 'home') { openIds.add('dnd'); openIds.add('d52'); }

const crumb = trail.slice(0, -1).map((n) => label(n, lang)).join('  ·  ');

const other: Lang = lang === 'en' ? 'ru' : 'en';
// Слаг из URL, а НЕ из nav-дерева: у страниц вне nav (обзор группы вроде classes/classes)
// nodeBySlug ничего не находит, из-за чего пара строилась как у хаба — переключатель языка
// вёл на /ru/, а hreflang выводил корневую тройку (checker: «no return tag»).
// Парность EN↔RU гарантирована контент-пайплайном (зеркальная структура файлов).
// Для хабов /en/·/ru/ и корня pathSlug пуст.
const currentPath = Astro.url.pathname;
const pathSlug = currentPath.replace(/^\/(en|ru)\//, '').replace(/\/+$/, '');
const counterpart = pathSlug ? `/${other}/${pathSlug}/` : `/${other}/`;
// URL каждого языка (для мобильного <select>): текущий язык → текущий путь, другой → counterpart
const enUrl = lang === 'en' ? currentPath : counterpart;
const ruUrl = lang === 'ru' ? currentPath : counterpart;

// hreflang-пары (пути от корня) — та же парность slug'ов, что и у переключателя языка.
// Корень (bilingual) выводит тройку сам; здесь — контентные страницы и хабы систем.
//  • контентная (pathSlug непуст): en/ru — маршруты пары, x-default → EN.
//  • хаб (pathSlug пуст, не корень): /en/ ↔ /ru/, x-default → «/» (зеркало корня-кластера).
const alternates = bilingual
  ? undefined
  : pathSlug
    ? { en: routeOf(pathSlug, 'en'), ru: routeOf(pathSlug, 'ru'), xDefault: routeOf(pathSlug, 'en') }
    : { en: '/en/', ru: '/ru/', xDefault: '/' };

// prev/next пропускают hidden-узлы (скрытые из сайдбара глоссарий-списки, заменённые
// хабами): иначе поток «дальше» уводил бы читателя в 2-3 страницы подряд, которых нет в
// дереве. Соседей самой скрытой страницы считаем до ближайшего видимого в обе стороны.
const idx = FLAT_PAGES.findIndex((p) => p.id === currentId);
const visibleFrom = (start: number, step: number) => {
  for (let i = start; i >= 0 && i < FLAT_PAGES.length; i += step) {
    if (!FLAT_PAGES[i].hidden) return FLAT_PAGES[i];
  }
  return null;
};
const prev = idx > 0 ? visibleFrom(idx - 1, -1) : null;
const next = idx >= 0 ? visibleFrom(idx + 1, 1) : null;

// ── JSON-LD (schema.org) — для rich-результатов и хлебных крошек в выдаче ───────
const SITE = 'https://rules.omnisgm.com';
const pageUrl = SITE + currentPath; // currentPath с trailing slash (trailingSlash:'always')
// URL узла: страница → её маршрут, группа → первая страница-лист под ней.
const nodeRoute = (n: NavNode): string =>
  isGroup(n) ? (flattenPages(n.kids)[0] ? routeOf(flattenPages(n.kids)[0].slug, lang) : homeRoute(lang))
             : routeOf(n.slug, lang);
const org = {
  '@type': 'Organization', '@id': SITE + '/#org', name: 'OmnisGM', url: MAIN,
  logo: { '@type': 'ImageObject', url: SITE + '/icon-512.png', width: 512, height: 512 },
};
const webSite = {
  '@type': 'WebSite', '@id': SITE + '/#website', url: SITE + '/',
  name: 'OmnisGM Rules', inLanguage: lang, publisher: { '@id': SITE + '/#org' },
};
const graph: object[] = [org, webSite];
if (currentId !== 'home' && trail.length) {
  const crumbs = [{ name: t('Главная', 'Home'), url: homeRoute(lang) }, ...trail.map((n) => ({ name: label(n, lang), url: nodeRoute(n) }))];
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: SITE + c.url })),
  });
  graph.push({
    '@type': 'Article', '@id': pageUrl + '#article',
    headline: searchTitle ?? title, url: pageUrl, inLanguage: lang,
    ...(description ? { description } : {}),
    isPartOf: { '@id': SITE + '/#website' }, publisher: { '@id': SITE + '/#org' },
  });
}
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
// Группируем h3 под их h2 для сворачиваемого TOC (по умолчанию свёрнуто, активная секция раскрыта скриптом)
type TocGroup = { h2: { slug: string; text: string }; subs: { slug: string; text: string }[] };
const tocGroups: TocGroup[] = [];
for (const h of toc) {
  if (h.depth === 2 || tocGroups.length === 0) tocGroups.push({ h2: h, subs: [] });
  else tocGroups[tocGroups.length - 1].subs.push(h);
}

// Опции Pagefind UI: локализованный плейсхолдер; счётчик «N results»/«Searching…»
// убран (пустые строки → скрыто CSS), оставлен только полезный «ничего не найдено».
const searchUi = {
  showImages: false, showSubResults: true, excerptLength: 12, resetStyles: false,
  translations: {
    placeholder: t('Поиск', 'Search'),
    zero_results: t('Ничего не найдено: [SEARCH_TERM]', 'No results for [SEARCH_TERM]'),
    searching: '', many_results: '', one_result: '',
  },
};
---
<Reader title={title} description={description} lang={lang} bilingual={bilingual} titleRu={titleRu} jsonLd={jsonLd} alternates={alternates} image={image} imageWidth={imageWidth} imageHeight={imageHeight}>
  <div class="rd-root">
    {/* Мобильные тогглы на CSS-радио (без JS): якоря первыми в .rd-root. Общий name="rd-panel"
        делает панели взаимоисключающими; rd-panel-none — закрытое состояние (по умолчанию).
        rd-drawer-cb — «Разделы» (слева), rd-onpage-cb — «На странице» (справа), rd-search-cb — поиск (оверлей). */}
    <input type="radio" name="rd-panel" id="rd-panel-none" class="rd-toggle-cb" hidden checked />
    <input type="radio" name="rd-panel" id="rd-drawer-cb" class="rd-toggle-cb" hidden />
    <input type="radio" name="rd-panel" id="rd-onpage-cb" class="rd-toggle-cb" hidden />
    <input type="radio" name="rd-panel" id="rd-search-cb" class="rd-toggle-cb" hidden />

    <header class="rd-topbar">
      <div class="rd-brand">
        <a href={`${funnelBase}?utm_source=rules&utm_medium=topbar&utm_campaign=funnel`} class="rd-brand-link" aria-label="OmnisGM">
          <span class="rd-brand-mark" set:html={BRAND_MARK} />
          <span class="rd-brand-name">OmnisGM</span>
        </a>
        <span class="rd-brand-sub">/ rules</span>
      </div>
      <div class="rd-top-right">
        <a href={REPO} target="_blank" rel="noopener" class="rd-gh">GitHub ↗</a>
        {/* десктоп — кнопки-пара; мобила — выпадающий список (как в News) */}
        <div class="rd-lang">
          {bilingual ? (
            <>
              <a class="rd-lang-btn" data-l="en" href="/en/">ENG</a>
              <a class="rd-lang-btn" data-l="ru" href="/ru/" style="border-left:1px solid var(--og-border)">RU</a>
            </>
          ) : (
            <>
              <a class={'rd-lang-btn' + (lang === 'en' ? ' on' : '')} href={lang === 'en' ? undefined : counterpart}>ENG</a>
              <a class={'rd-lang-btn' + (lang === 'ru' ? ' on' : '')} href={lang === 'ru' ? undefined : counterpart} style="border-left:1px solid var(--og-border)">RU</a>
            </>
          )}
        </div>
        <select class="rd-lang-sel" aria-label="Language" onchange="if(this.value)location.href=this.value">
          <option value={bilingual ? '/en/' : enUrl} selected={lang === 'en'}>ENG</option>
          <option value={bilingual ? '/ru/' : ruUrl} selected={lang === 'ru'}>RU</option>
        </select>
      </div>
    </header>

    {/* Адаптивная липкая панель: системы (вкладки→список) + поиск (поле→кнопка) +
        кнопки «Разделы»/«На странице» (появляются, когда сайдбары скрыты по ширине). */}
    {/* role=navigation на баре — чтобы select систем и кнопки-действия попадали в landmark
        (axe best-practice «region»). Внутренний список вкладок — простой div (без вложенного nav). */}
    <div class="rd-systabs" role="navigation" aria-label={t('Системы и поиск', 'Systems and search')}>
      <div class="rd-systabs-tabs og-scroll">
        {SYSTEMS.map((s) => (
          <a href={systemRoute(s.id, lang)} class={'rd-systab' + (s.id === activeSys ? ' on' : '')} aria-current={s.id === activeSys ? 'page' : undefined}>
            <I18n en={label(s as any, 'en')} ru={label(s as any, 'ru')} bilingual={bilingual} lang={lang} />
          </a>
        ))}
      </div>
      <select class="rd-sysmenu" aria-label={t('Система', 'System')} onchange="if(this.value)location.href=this.value">
        {SYSTEMS.map((s) => (
          <option value={systemRoute(s.id, lang)} selected={s.id === activeSys} data-ru={bilingual ? label(s as any, 'ru') : undefined}>{label(s as any, lang)}</option>
        ))}
      </select>
      <div class="rd-bar-actions">
        <div class="rd-search-slot">
          <Search id="rd-search-d" className="pagefind-ui" uiOptions={searchUi} />
        </div>
        <label for="rd-search-cb" class="rd-iconbtn rd-act rd-act-search" aria-label={t('Поиск', 'Search')}>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="4.4" stroke="currentColor" stroke-width="1.4" /><path d="m10.6 10.6 3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
        </label>
        <label for="rd-drawer-cb" class="rd-iconbtn rd-iconbtn-txt rd-act rd-act-nav" aria-label={t('Разделы', 'Sections')}>
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M2 4h12M2 8h12M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
          <span><I18n en="Sections" ru="Разделы" bilingual={bilingual} lang={lang} /></span>
        </label>
        {toc.length > 1 && (
          <label for="rd-onpage-cb" class="rd-iconbtn rd-iconbtn-txt rd-act rd-act-toc" aria-label={t('На странице', 'On this page')}>
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M6 4h8M6 8h8M6 12h8M2.5 4h.01M2.5 8h.01M2.5 12h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            <span><I18n en="Page" ru="Страница" bilingual={bilingual} lang={lang} /></span>
          </label>
        )}
      </div>
    </div>

    <div class={'rd-body' + (toc.length > 1 ? '' : ' rd-no-toc')}>
      <aside class="rd-nav og-scroll" aria-label={t('Разделы', 'Sections')}>
        <NavTree nodes={navRoots} lang={lang} currentId={currentId} openIds={openIds} bilingual={bilingual} />
      </aside>

      <main class="rd-content og-scroll">
        <div class="rd-content-inner">
          {crumb && <div class="rd-crumb">{crumb}</div>}
          <article class="rd-doc" data-pagefind-body={bilingual ? undefined : true} data-pagefind-ignore={bilingual ? true : undefined} data-pagefind-meta={!bilingual && searchTitle ? `title:${searchTitle}` : undefined}>
            <slot />
          </article>

          {/* CTA-воронка в основной продукт (лист персонажа). Событие Analytics на клик.
              UTM — атрибуция конверсии в аналитике Table (#14): utm_content = currentId
              (компактный nav-id страницы, языконезависимый; sourceId с путём/языком —
              избыточен для отчётов, страница «какая конвертит» важнее языка). */}
          <a
            class="rd-cta"
            href={`${funnelBase}?utm_source=rules&utm_medium=cta&utm_campaign=funnel&utm_content=${encodeURIComponent(currentId)}`}
            data-pagefind-ignore
            onclick={`window.omnisTrack&&window.omnisTrack('cta_character_sheet',{from:'reader',page:'${currentId}'})`}
          >
            <span class="rd-cta-body">
              <span class="rd-cta-title"><I18n en="Build your character in OmnisGM" ru="Соберите персонажа в OmnisGM" bilingual={bilingual} lang={lang} /></span>
              <span class="rd-cta-sub"><I18n en="An interactive character sheet — for these very rules." ru="Интерактивный лист персонажа — по этим самым правилам." bilingual={bilingual} lang={lang} /></span>
            </span>
            <span class="rd-cta-arrow" aria-hidden="true">→</span>
          </a>

          {sourceId && (
            <div class="rd-source">
              <span>{t('Источник', 'Source')}</span>
              <a href={`${REPO}/blob/${REPO_BRANCH}/src/${sourceId}.md`} target="_blank" rel="noopener">src/{sourceId}.md ↗</a>
            </div>
          )}

          {attribution && (
            <div class="rd-attrib" data-pagefind-ignore>
              {/* §15 BRP OGL: «prominently display … BRP logo … on the title page or its equivalent» —
                  для веба показываем официальный логотип на каждой странице BRP-раздела рядом с атрибуцией. */}
              {activeSys === 'brp' && (
                <a class="rd-attrib-logo" href="https://www.chaosium.com/orclicense/" target="_blank" rel="noopener">
                  <img src="/powered-by-brp.png" alt="Powered by BRP — Basic Roleplaying, Chaosium Inc." width="80" height="80" loading="lazy" />
                </a>
              )}
              <span set:html={t(attribution.ru, attribution.en)} />{' '}
              <a href={legalHref}>{t('Правовая информация', 'Legal')}</a>
              {/* Портреты существ (#201) — наши, а не часть SRD: лицензия выше относится к тексту
                  правил, поэтому авторство картинок стоит отдельной строкой и только там, где
                  картинка есть. */}
              {image && (
                <div class="rd-attrib-img">
                  {t('Изображения существ — © OmnisGM; не входят в SRD и не покрываются его лицензией.',
                     'Creature images © OmnisGM — not part of the SRD and not covered by its license.')}
                </div>
              )}
            </div>
          )}

          {(prev || next || upLink) && (
            <div class={`rd-prevnext${upLink ? ' rd-has-up' : ''}`}>
              {prev ? (
                <a class="rd-pn" href={routeOf(prev.slug, lang)}>
                  <span class="rd-pn-k">← {t('Назад', 'Previous')}</span>
                  <span class="rd-pn-t">{label(prev, lang)}</span>
                </a>
              ) : <span />}
              {upLink && (
                <a class="rd-pn-up" href={upLink.href}>
                  <span class="rd-pn-k">↑ {t('В раздел', 'Section')}</span>
                  <span class="rd-pn-t">{t(upLink.ru, upLink.en)}</span>
                </a>
              )}
              {next ? (
                <a class="rd-pn rd-pn-r" href={routeOf(next.slug, lang)}>
                  <span class="rd-pn-k">{t('Вперёд', 'Next')} →</span>
                  <span class="rd-pn-t">{label(next, lang)}</span>
                </a>
              ) : <span />}
            </div>
          )}
        </div>
      </main>

      {toc.length > 1 && (
        <aside class="rd-toc og-scroll" id="rd-toc" aria-label={t('На этой странице', 'On this page')}>
          <div class="rd-toc-h"><I18n en="On this page" ru="На этой странице" bilingual={bilingual} lang={lang} /></div>
          <div class="rd-toc-list">
            {tocGroups.map((g) => (
              <div class={'rd-toc-grp' + (g.subs.length ? ' has-subs' : '')}>
                <a class="rd-toc-link rd-toc-h2" href={`#${g.h2.slug}`} data-toc={g.h2.slug}>{g.h2.text}</a>
                {g.subs.length > 0 && (
                  <div class="rd-toc-subs">
                    {g.subs.map((s) => (
                      <a class="rd-toc-link rd-toc-sub" href={`#${s.slug}`} data-toc={s.slug}>{s.text}</a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>
        </aside>
      )}
    </div>

    {/* «Разделы» — левый drawer, только дерево разделов (системы ушли в список выше) */}
    <label for="rd-panel-none" class="rd-scrim" aria-hidden="true"></label>
    <div class="rd-drawer og-scroll" role="dialog" aria-modal="true" tabindex="-1" aria-label={t('Разделы', 'Sections')}>
      <div class="rd-drawer-top">
        <span class="rd-drawer-title"><I18n en="Sections" ru="Разделы" bilingual={bilingual} lang={lang} /></span>
        <label for="rd-panel-none" class="rd-drawer-x" aria-label={t('Закрыть', 'Close')}>×</label>
      </div>
      <NavTree nodes={navRoots} lang={lang} currentId={currentId} openIds={openIds} bilingual={bilingual} />
    </div>

    {/* «На странице» — правый drawer, навигация по текущей странице. Сворачиваемые группы
        (h3 под h2) — как в десктопном TOC: каретка разворачивает группу, тап по пункту ведёт + закрывает. */}
    <label for="rd-panel-none" class="rd-scrim" aria-hidden="true"></label>
    <div class="rd-onpage og-scroll" role="dialog" aria-modal="true" tabindex="-1" aria-label={t('На этой странице', 'On this page')}>
      <div class="rd-drawer-top">
        <span class="rd-drawer-title"><I18n en="On this page" ru="На этой странице" bilingual={bilingual} lang={lang} /></span>
        <label for="rd-panel-none" class="rd-drawer-x" aria-label={t('Закрыть', 'Close')}>×</label>
      </div>
      {toc.length > 1 ? (
        <div class="rd-toc-list">
          {tocGroups.map((g) => (
            <div class={'rd-toc-grp' + (g.subs.length ? ' has-subs' : '')}>
              <div class="rd-toc-row">
                {g.subs.length > 0 && (
                  <button type="button" class="rd-toc-caret" aria-label={t('Развернуть', 'Expand')} aria-expanded="false"></button>
                )}
                <a class="rd-toc-link rd-toc-h2" href={`#${g.h2.slug}`} data-toc={g.h2.slug}
                   onclick="var c=document.getElementById('rd-panel-none');if(c)c.checked=true">{g.h2.text}</a>
              </div>
              {g.subs.length > 0 && (
                <div class="rd-toc-subs">
                  {g.subs.map((s) => (
                    <a class="rd-toc-link rd-toc-sub" href={`#${s.slug}`} data-toc={s.slug}
                       onclick="var c=document.getElementById('rd-panel-none');if(c)c.checked=true">{s.text}</a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="rd-nomatch">{t('На этой странице нет разделов', 'No sections on this page')}</div>
      )}
    </div>

    {/* Поиск — полноэкранный оверлей (отдельная кнопка 🔍) */}
    <label for="rd-panel-none" class="rd-scrim" aria-hidden="true"></label>
    <div class="rd-search-overlay" role="dialog" aria-modal="true" aria-label={t('Поиск', 'Search')}>
      <div class="rd-drawer-top">
        <span class="rd-drawer-title"><I18n en="Search" ru="Поиск" bilingual={bilingual} lang={lang} /></span>
        <label for="rd-panel-none" class="rd-drawer-x" aria-label={t('Закрыть', 'Close')}>×</label>
      </div>
      <div class="rd-search-overlay-body">
        <Search id="rd-search-m" className="pagefind-ui" uiOptions={searchUi} />
      </div>
    </div>
  </div>
</Reader>

{/* Клик по тексту-выдержке результата поиска ведёт туда же, куда заголовок этого под-результата
    (Pagefind рендерит выдержку обычным <p>, поэтому навигацию вешаем делегированно). */}
<script>
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const ex = target.closest?.('.pagefind-ui__result-excerpt');
    if (!ex) return;
    // не мешаем выделению текста
    const sel = window.getSelection?.();
    if (sel && String(sel).trim()) return;
    const box = ex.closest('.pagefind-ui__result-nested') || ex.closest('.pagefind-ui__result-inner');
    const link = box?.querySelector<HTMLAnchorElement>('a.pagefind-ui__result-link');
    if (link) link.click();
  });
</script>

{/* Скроллспай «На этой странице»: подсветка читаемого раздела в реальном времени +
    авто-раскрытие активной группы (h3 свёрнуты по умолчанию). */}
<script>
  // Ссылки TOC в ОБОИХ контейнерах: правый столбец #rd-toc (десктоп) и drawer .rd-onpage (мобила).
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.rd-toc-link[data-toc]'));
  if (links.length) {
    // уникальные id заголовков в порядке появления (общие для обоих контейнеров)
    const ids = [...new Set(links.map((l) => l.dataset.toc!))];
    const heads = ids
      .map((id) => document.getElementById(id))
      .filter((h): h is HTMLElement => !!h);
    const grps = Array.from(document.querySelectorAll('.rd-toc-grp'));
    let activeId = '';
    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      for (const l of links) l.classList.toggle('rd-toc-active', l.dataset.toc === id);
      // раскрываем активную группу в каждом контейнере (та, что содержит активную ссылку)
      for (const g of grps) {
        const open = !!g.querySelector(`.rd-toc-link[data-toc="${id}"]`);
        g.classList.toggle('open', open);
        g.querySelector('.rd-toc-caret')?.setAttribute('aria-expanded', String(open));
      }
    };
    let ticking = false;
    const update = () => {
      ticking = false;
      const threshold = window.scrollY + 140;
      let cur = heads[0];
      for (const h of heads) {
        if (h.getBoundingClientRect().top + window.scrollY <= threshold) cur = h;
        else break;
      }
      if (cur) setActive(cur.id);
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  }
</script>

{/* Поиск: бейдж системы у результата (из URL) + сортировка
    «текущая страница → текущая система → остальное» (пост-обработка DOM Pagefind). */}
<script>
  const SYS: Record<string, string> = {
    'dnd/srd-5.2': 'D&D 5.2.1',
    'dnd/srd-5.1': 'D&D 5.1',
    'dnd/converting-srd-5.2': 'D&D 5.1→5.2.1',
    'daggerheart/srd-1.0': 'Daggerheart',
    'brp/srd-1.0': 'Basic Roleplaying',
  };
  const sysKey = (p: string) => {
    const s = p.split('?')[0].split('#')[0].split('/').filter(Boolean); // [lang, game, version, …]
    return s.length >= 3 ? `${s[1]}/${s[2]}` : '';
  };
  const curPath = location.pathname.replace(/\/$/, '');
  const curSys = sysKey(location.pathname);

  const process = (root: Element) => {
    const results = Array.from(root.querySelectorAll<HTMLElement>('.pagefind-ui__result'));
    if (!results.length) return;
    const list = results[0].parentNode as HTMLElement;
    const order: number[] = [];
    results.forEach((r, i) => {
      const link = r.querySelector<HTMLAnchorElement>('.pagefind-ui__result-link');
      const path = (link?.getAttribute('href') || '').split('?')[0].split('#')[0];
      const key = sysKey(path);
      // бейдж системы (один раз)
      if (!r.querySelector('.rd-sys-badge') && SYS[key]) {
        const title = r.querySelector('.pagefind-ui__result-title');
        if (title) {
          const b = document.createElement('span');
          b.className = 'rd-sys-badge';
          b.textContent = SYS[key];
          title.appendChild(b);
        }
      }
      const norm = path.replace(/\/$/, '');
      (r as any)._prio = norm === curPath ? 0 : key && key === curSys ? 1 : 2;
      order[i] = i;
    });
    // стабильная сортировка по приоритету; трогаем DOM только если порядок изменился
    const sorted = results.map((r, i) => ({ r, i })).sort((a, b) => ((a.r as any)._prio - (b.r as any)._prio) || (a.i - b.i));
    let changed = false;
    for (let i = 0; i < sorted.length; i++) if (sorted[i].r !== results[i]) { changed = true; break; }
    if (changed) for (const { r } of sorted) list.appendChild(r);
  };

  // Доступность Pagefind:
  // 1) инпут лейблится только title → даём aria-label из плейсхолдера (label-title-only);
  // 2) форма Pagefind имеет role=search; на десктопе видны ОБА инстанса (бар + оверлей) →
  //    два одинаковых search-лендмарка (landmark-unique). Снимаем роль у мобильного (он и так
  //    внутри диалога «Поиск»), оставляя единственный search-лендмарк — в баре.
  const a11y = (root: Element, isOverlay: boolean) => {
    const i = root.querySelector<HTMLInputElement>('input.pagefind-ui__search-input');
    if (i && !i.getAttribute('aria-label')) i.setAttribute('aria-label', i.getAttribute('placeholder') || 'Search');
    if (isOverlay) root.querySelector('form.pagefind-ui__form[role="search"]')?.removeAttribute('role');
  };

  for (const id of ['rd-search-d', 'rd-search-m']) {
    const root = document.getElementById(id);
    if (!root) continue;
    const isOverlay = id === 'rd-search-m';
    a11y(root, isOverlay);
    let t: number;
    new MutationObserver(() => { a11y(root, isOverlay); clearTimeout(t); t = window.setTimeout(() => process(root), 60); })
      .observe(root, { childList: true, subtree: true });
  }
</script>

{/* Доступность панелей (drawer'ы/поиск): открытие фокусирует панель, Tab зациклен внутри,
    Esc закрывает, фокус возвращается на триггер. Панели открываются CSS-радио — реагируем на change. */}
<script>
  const PANELS: Record<string, string> = {
    'rd-drawer-cb': '.rd-drawer',
    'rd-onpage-cb': '.rd-onpage',
    'rd-search-cb': '.rd-search-overlay',
  };
  const noneCb = document.getElementById('rd-panel-none') as HTMLInputElement | null;
  let active: HTMLElement | null = null;
  let lastFocus: HTMLElement | null = null;
  const focusables = (el: HTMLElement) =>
    Array.from(el.querySelectorAll<HTMLElement>('a[href],button:not([disabled]),input:not([disabled]),select:not([disabled]),textarea,[tabindex]:not([tabindex="-1"])'))
      .filter((e) => e.offsetParent !== null);

  const sync = () => {
    let panel: HTMLElement | null = null;
    for (const [id, sel] of Object.entries(PANELS)) {
      const cb = document.getElementById(id) as HTMLInputElement | null;
      if (cb?.checked) { panel = document.querySelector<HTMLElement>(sel); break; }
    }
    if (panel === active) return;
    if (panel) {
      if (!active) lastFocus = document.activeElement as HTMLElement;
      active = panel;
      const f = focusables(panel);
      requestAnimationFrame(() => {
        // Фокусируем САМ контейнер (tabindex=-1) — без видимой рамки на контроле.
        // Исключение — поиск: фокус на поле, чтобы сразу печатать (рамка поля ожидаема).
        const target = panel!.classList.contains('rd-search-overlay') ? (f[0] || panel!) : panel!;
        target.focus({ preventScroll: true });
        // «На странице»: доскроллить подсвеченный текущий раздел в центр панели
        if (panel!.classList.contains('rd-onpage')) {
          panel!.querySelector('.rd-toc-active')?.scrollIntoView({ block: 'center' });
        }
      });
    } else {
      active = null;
      if (lastFocus) { lastFocus.focus(); lastFocus = null; }
    }
  };
  document.querySelectorAll<HTMLInputElement>('input[name="rd-panel"]').forEach((r) => r.addEventListener('change', sync));
  document.addEventListener('keydown', (e) => {
    if (!active) return;
    if (e.key === 'Escape') { e.preventDefault(); if (noneCb) { noneCb.checked = true; sync(); } }
    else if (e.key === 'Tab') {
      const f = focusables(active);
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
</script>

{/* «На странице» (drawer): каретка разворачивает/сворачивает группу подразделов (h3). */}
<script>
  document.querySelectorAll<HTMLButtonElement>('.rd-onpage .rd-toc-caret').forEach((btn) => {
    btn.addEventListener('click', () => {
      const grp = btn.closest('.rd-toc-grp');
      if (!grp) return;
      const open = grp.classList.toggle('open');
      btn.setAttribute('aria-expanded', String(open));
    });
  });
</script>

{/* Двуязычный корень в RU-режиме: UI поиска собран на EN (lang="en"), а data-rootlang=ru
    ставит только корень при RU-локали. Локализуем плейсхолдер, кнопку очистки и «ничего не найдено». */}
<script>
  if (document.documentElement.getAttribute('data-rootlang') === 'ru') {
    const localize = (root: Element) => {
      root.querySelectorAll<HTMLInputElement>('input.pagefind-ui__search-input').forEach((i) => { i.placeholder = 'Поиск'; });
      root.querySelectorAll('.pagefind-ui__search-clear').forEach((b) => b.setAttribute('aria-label', 'Очистить'));
      root.querySelectorAll('.pagefind-ui__message').forEach((m) => {
        const mm = (m.textContent || '').match(/^No results for\s+(.*)$/i);
        if (mm) m.textContent = `Ничего не найдено: ${mm[1]}`;
      });
    };
    for (const id of ['rd-search-d', 'rd-search-m']) {
      const root = document.getElementById(id);
      if (!root) continue;
      localize(root);
      new MutationObserver(() => localize(root)).observe(root, { childList: true, subtree: true });
    }
  }
</script>

{/* Hovercard автоссылок (issue #20, вариант B): при наведении/фокусе на a.ent-link[data-hc]
    показываем карточку сущности. Данные тянутся один раз на бакет game/verKey/lang из
    /hc/{game}/{ver}/{lang}.json (ключ бакета = префикс data-hc). Карточка — единый элемент в body. */}
<script>
  type HCard = { name: string; name_en: string | null; effect: string; href: string };
  const hcBuckets = new Map<string, Promise<Record<string, HCard> | null>>();
  const hcLoad = (game: string, ver: string, lang: string) => {
    const key = `${game}/${ver}/${lang}`;
    let p = hcBuckets.get(key);
    if (!p) {
      p = fetch(`/hc/${game}/${ver}/${lang}.json`).then((r) => (r.ok ? r.json() : null)).catch(() => null);
      hcBuckets.set(key, p);
    }
    return p;
  };

  const card = document.createElement('div');
  card.className = 'ent-hovercard';
  card.id = 'ent-hovercard';
  card.setAttribute('role', 'tooltip');
  // Шапка: слева EN-имя (только в RU-карточке — имя, на которое навели, уже перед глазами;
  // в EN оно избыточно), справа источник. Ниже — эффект.
  const SRC: Record<string, string> = { srd52: 'SRD 5.2.1', srd51: 'SRD 5.1' };
  const head = document.createElement('div'); head.className = 'ent-hc-head';
  const elEn = document.createElement('span'); elEn.className = 'ent-hc-en';
  const elSrc = document.createElement('span'); elSrc.className = 'ent-hc-src';
  head.append(elEn, elSrc);
  const elBody = document.createElement('div'); elBody.className = 'ent-hc-body';
  card.append(head, elBody);
  let mounted = false;

  let current: HTMLElement | null = null;
  let showTimer = 0;
  let token = 0;

  const place = (anchor: HTMLElement) => {
    const r = anchor.getBoundingClientRect();
    const cw = card.offsetWidth, ch = card.offsetHeight, pad = 8, gap = 6;
    const vw = document.documentElement.clientWidth, vh = document.documentElement.clientHeight;
    let left = Math.min(r.left, vw - cw - pad);
    left = Math.max(pad, left) + window.scrollX;
    let top = r.bottom + gap;
    if (r.bottom + gap + ch > vh && r.top - gap - ch > 0) top = r.top - ch - gap;
    card.style.left = `${left}px`;
    card.style.top = `${top + window.scrollY}px`;
  };

  const hide = () => {
    clearTimeout(showTimer); showTimer = 0; token++;
    if (!current) return;
    current.removeAttribute('aria-describedby');
    current = null;
    card.classList.remove('is-open');
  };

  const show = (anchor: HTMLElement) => {
    const hc = anchor.getAttribute('data-hc');
    if (!hc) return;
    const parts = hc.split('/');
    if (parts.length < 5) return;
    const [game, ver, lang] = parts;
    const rkey = parts.slice(3).join('/');
    const my = ++token;
    hcLoad(game, ver, lang).then((map) => {
      if (my !== token) return;
      const c = map && map[rkey];
      if (!c) return;
      // EN-оригинал в шапке — ВСЕГДА, независимо от языка страницы (в EN он совпадает с именем ссылки).
      if (c.name_en) { elEn.textContent = c.name_en; elEn.style.display = ''; }
      else { elEn.textContent = ''; elEn.style.display = 'none'; }
      elSrc.textContent = SRC[ver] || '';
      elBody.innerHTML = c.effect || ''; // доверенный контент (наши SRD-данные, экранированы на билде)
      elBody.style.display = c.effect ? '' : 'none';
      if (!mounted) { document.body.appendChild(card); mounted = true; }
      current = anchor;
      anchor.setAttribute('aria-describedby', 'ent-hovercard');
      card.classList.add('is-open');
      place(anchor);
    });
  };

  // Цели hovercard: автоссылки (a.ent-link) и глоссарные термины без страницы (span.gloss).
  const HC_SEL = 'a.ent-link[data-hc], .gloss[data-hc]';
  const onEnter = (e: Event) => {
    if ('pointerType' in e && (e as PointerEvent).pointerType === 'touch') return; // тач — навигация тапом
    const a = (e.target as Element)?.closest?.(HC_SEL) as HTMLElement | null;
    if (!a || a === current) return;
    clearTimeout(showTimer);
    showTimer = window.setTimeout(() => show(a), e.type === 'focusin' ? 0 : 130);
  };
  const onLeave = (e: Event) => {
    const a = (e.target as Element)?.closest?.(HC_SEL);
    if (!a) return;
    const to = (e as PointerEvent).relatedTarget as Node | null;
    if (to && (a as Element).contains(to)) return;
    hide();
  };

  document.addEventListener('pointerover', onEnter, { passive: true });
  document.addEventListener('pointerout', onLeave, { passive: true });
  document.addEventListener('focusin', onEnter);
  document.addEventListener('focusout', (e) => {
    if (current && (e.target as Element)?.closest?.(HC_SEL) === current) hide();
  });
  document.addEventListener('keydown', (e) => { if ((e as KeyboardEvent).key === 'Escape') hide(); });
  // Карточка позиционируется в координатах документа и «едет» вместе со ссылкой при скролле —
  // прятать по scroll не нужно (и вредно: авто-скролл перед hover/focus гасил бы показ).
  // По ресайзу — прячем открытую (геометрия ссылки могла сместиться).
  window.addEventListener('resize', () => { if (current) hide(); }, { passive: true });
</script>

{/* Сортируемые хаб-таблицы (issue #20): <table class="hub-table" data-sortable>. Клик/Enter по
    <th> сортирует строки по колонке. Ключ сортировки — атрибут data-sort ячейки (для CR/уровня —
    числовой порядок), иначе видимый текст. Колонка сравнивается численно, если все ключи числа,
    иначе localeCompare по языку страницы. Прогрессивное улучшение: без JS таблица просто статична. */}
<script>
  const lang = document.documentElement.lang || undefined;
  const cellKey = (row: HTMLTableRowElement, i: number): string => {
    const c = row.cells[i];
    if (!c) return '';
    const d = c.getAttribute('data-sort');
    return d !== null ? d : (c.textContent || '').trim();
  };
  for (const table of document.querySelectorAll<HTMLTableElement>('table[data-sortable]')) {
    const tbody = table.tBodies[0];
    const ths = Array.from(table.tHead?.rows[0]?.cells ?? []);
    if (!tbody || !ths.length) continue;
    const sortBy = (i: number, dir: 1 | -1) => {
      const rows = Array.from(tbody.rows);
      const keys = rows.map((r) => cellKey(r, i));
      const numeric = keys.every((k) => k !== '' && !Number.isNaN(Number(k)));
      rows.sort((a, b) => {
        const ka = cellKey(a, i), kb = cellKey(b, i);
        const cmp = numeric ? Number(ka) - Number(kb) : ka.localeCompare(kb, lang);
        return cmp * dir;
      });
      for (const r of rows) tbody.appendChild(r);
    };
    ths.forEach((th, i) => {
      th.tabIndex = 0;
      th.setAttribute('role', 'button');
      const activate = () => {
        const dir: 1 | -1 = th.getAttribute('aria-sort') === 'ascending' ? -1 : 1;
        for (const o of ths) o.removeAttribute('aria-sort');
        th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
        sortBy(i, dir);
      };
      th.addEventListener('click', activate);
      th.addEventListener('keydown', (e) => {
        const k = (e as KeyboardEvent).key;
        if (k === 'Enter' || k === ' ') { e.preventDefault(); activate(); }
      });
    });
  }
</script>

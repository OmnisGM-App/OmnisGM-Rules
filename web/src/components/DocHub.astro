---
// Хаб уровня документа (issue #230): /{lang}/{game}/{version}/ — страница самой редакции.
//
// Зачем: по полному SEO-аудиту 2026-09-01 главный дефицит сайта не техника, а КРАУЛИНГ —
// «обнаружена, не проиндексирована» у 5 807 URL из 5 975. Лечится это структурой и ссылочным
// весом сверху, а верхнего узла у нас не было вовсе: URL уровня документа не существовал,
// и путь от главной к 6000 страниц шёл через одну случайную «первую страницу» (Legal).
// Хаб — и посадочная под «система + редакция» («D&D SRD 5.2.1», «Daggerheart SRD»), и точка,
// из которой краулер видит ВСЕ разделы и компендиумы документа за один переход.
//
// Ссылки строятся из того же NAV-дерева, что и сайдбар: второго источника правды не заводим —
// иначе хаб начнёт расходиться с навигацией ровно в тот день, когда кто-то добавит главу.
import ReaderShell from './ReaderShell.astro';
import {
  findPath, isGroup, label, routeOf, flattenPages,
  type Lang, type NavGroup, type NavNode, type NavPage,
} from '../lib/nav';
import { pageTitle } from '../lib/page-title';
import { resourceTotal } from '../lib/entity-counts.mjs';
import { isIndexableGlossary } from '../lib/glossary-seo.mjs';
import { pluralRu } from '../lib/plural.mjs';

interface Props {
  lang: Lang;
  game: string;      // 'dnd' | 'daggerheart' | 'brp'
  groupId: string;   // id узла-редакции в NAV: 'd52', 'd51', 'dh', 'brp10'
  version: string;   // ключ API: 'srd52' | 'srd51' | 'srd10'
}
const { lang, game, groupId, version } = Astro.props;
const t = (ru: string, en: string) => (lang === 'en' ? en : ru);

const trail = findPath(groupId) ?? [];
const docGroup = trail[trail.length - 1] as NavGroup;
const sysLabel = label(trail[0], lang);
const verLabel = label(docGroup, lang);
// Слаг документа берём из первой же страницы внутри: он и есть «game/version».
const docSlug = flattenPages(docGroup.kids)[0].slug.split('/').slice(0, 2).join('/');

// Разделы: прямые дети редакции. Группа «Классы» разворачивается списком классов — это
// 9–12 внутренних ссылок на страницы, до которых иначе два перехода. Группа «Глоссарий»
// показывается отдельным блоком компендиумов ниже, здесь пропускается.
// ГРУППА «Глоссарий», а не одноимённая глава: в D&D 5.2 рядом живёт страница «Глоссарий
// правил» (id d52-rulesglossary) — по проверке «id кончается на glossary» она попадала первой,
// find возвращал страницу вместо группы, компендиумы исчезали, а сама глава выпадала из
// оглавления. Отсюда и isGroup, и дефис в суффиксе.
const isGlossary = (n: NavNode) => isGroup(n) && n.id.endsWith('-glossary');
const chapters = docGroup.kids.filter((n) => !isGlossary(n));
const compendiumNodes = (docGroup.kids.find(isGlossary) as NavGroup | undefined)?.kids ?? [];
// Компендиумы — наши /all/-хабы плюс содержательные глоссарные справочники (#106). Из списка
// выпадают скрытые узлы и noindex-страницы: вести с хаба на страницу, закрытую от индекса, —
// это ровно та трата краул-бюджета, ради экономии которой её и закрыли. Признак noindex берём
// из того же isIndexableGlossary, что и <meta robots> в Reader.astro, а не заводим второй.
const indexable = (page: NavPage) => {
  const route = routeOf(page.slug, lang);
  return !route.includes('/glossary/') || isIndexableGlossary(route);
};
const compendiums = compendiumNodes.filter(
  (n): n is NavPage => !isGroup(n) && !n.hidden && indexable(n),
);

// Счётчик сущностей у компендиума: /{game}/{ver}/{segment}/all → ресурс API. Число берём из
// meta.json того же API, что кормит сами страницы сущностей, — не пересчитываем ничего заново.
// Сегмент URL и имя ресурса почти всегда совпадают; две пары, где они разошлись исторически,
// перечислены явно. Ресурса может не быть вовсе (напр. «Виды и предыстории» — это два ресурса
// на одной странице) — тогда число просто не печатается.
const RESOURCE_OF_SEGMENT: Record<string, string> = {
  'monsters-a-z': 'monsters',
  'rules-glossary': 'rules-terms',
};
const totalOf = (page: NavPage) => {
  const [, , segment, tail] = page.slug.split('/');
  if (!tail) return null;
  return resourceTotal(game, version, lang, RESOURCE_OF_SEGMENT[segment] ?? segment);
};

const heading = `${sysLabel} ${verLabel}`;
// pageTitle сам приписывает метку системы и редакции по правилам #185 и #166 (у Daggerheart
// это «Daggerheart SRD» — требование DPCGL §2.5), поэтому именем страницы её дублировать
// нельзя: «SRD 1.0 — Daggerheart SRD 1.0» и вдобавок совпало бы у EN и RU (метка версии
// язык-нейтральная), то есть дало бы дубли title между языками — их гейт по dist ловит.
const title = pageTitle({ name: t('Правила и справочники', 'Rules and reference'), lang, game, version });

const chapterCount = chapters.reduce((n, c) => n + (isGroup(c) ? c.kids.length : 1), 0);
const entityCount = compendiums.reduce((n, c) => n + (totalOf(c) ?? 0), 0);
// Числа тут произвольные (884 страницы, 1042 страницы, 25 разделов) — форму существительного
// без pluralRu не угадать: захардкоженное «страниц» давало «884 страниц» в сниппете выдачи.
const sections = pluralRu(chapterCount, ['раздел', 'раздела', 'разделов']);
const pages = pluralRu(entityCount, ['страница', 'страницы', 'страниц']);
const description = t(
  `${sysLabel} ${verLabel} на русском: ${chapterCount} ${sections} правил и справочники — ${entityCount} ${pages} заклинаний, монстров, предметов и других сущностей со ссылками на каждую.`,
  `${sysLabel} ${verLabel} in full: ${chapterCount} rules sections plus reference compendiums — ${entityCount} pages of spells, monsters, items and other entities, each linked.`,
);

// Авторский текст хаба (Table#710): чем документ является и что с ним сделано здесь — не
// пересказ SRD. Хаб был «просканирована, не проиндексирована»: одно оглавление ничем не
// отличалось от сотен копий SRD. Абзацы свои у каждой редакции и языка — иначе тела хабов
// совпадали бы между собой. Факты сверены с src/ и README: перевод и словари терминов
// (src/{game}/translate/), состав компендиумов, лицензии.
const ABOUT: Record<string, { ru: string[]; en: string[] }> = {
  d52: {
    en: [
      'System Reference Document 5.2.1 is the open core of the 2024 edition of Dungeons & Dragons, published by Wizards of the Coast under CC BY 4.0. It covers how to play, character creation, all twelve classes with one subclass each, backgrounds and species, feats, equipment, spells, magic items and a full bestiary — enough to run a campaign.',
      'Here the whole document reads online, and every spell, monster, animal, magic item, feat and piece of gear has its own page, with lists by spell level, school and class, by challenge rating and creature type, and by rarity. The text follows 5.2.1, the corrected revision of 5.2.',
      'The Russian translation is ours and uses one D&D glossary, so a rule term reads the same in a class feature, a spell and a stat block. Every page has an English–Russian pair to check the original wording.',
    ],
    ru: [
      'System Reference Document 5.2.1 — открытое ядро редакции Dungeons & Dragons 2024 года, опубликованное Wizards of the Coast под лицензией CC BY 4.0. В нём правила игры, создание персонажа, все двенадцать классов с одним подклассом у каждого, предыстории и виды, черты, снаряжение, заклинания, магические предметы и полный бестиарий — достаточно, чтобы вести кампанию.',
      'Здесь документ читается целиком, а у каждого заклинания, монстра, животного, магического предмета, черты и предмета снаряжения — своя страница; есть списки по кругу, школе и классу заклинаний, по показателю опасности и типу существ, по редкости предметов. Текст соответствует 5.2.1 — исправленной ревизии 5.2.',
      'Перевод на русский — наш, по единому словарю терминов D&D: одно и то же понятие звучит одинаково в умении класса, в заклинании и в блоке статистики. У каждой страницы есть английская пара — сверить формулировку оригинала.',
    ],
  },
  d51: {
    en: [
      'System Reference Document 5.1 is the open core of the 2014 edition of D&D 5e. Wizards of the Coast released it under CC BY 4.0 in 2023, and much of the third-party material for fifth edition is still written against it, so many tables keep playing these rules.',
      'The reader gives the complete 5.1 text with a page for every spell, monster, magic item, race, weapon and armor. The Russian translation shares its glossary with our SRD 5.2.1, so the same term means the same thing in both editions — handy when a group mixes 2014 and 2024 books.',
      'Moving to the 2024 rules? SRD 5.2.1 comes with a conversion guide that lists what changed between the editions.',
    ],
    ru: [
      'System Reference Document 5.1 — открытое ядро редакции D&D 5e 2014 года. В 2023 году Wizards of the Coast перевела его под лицензию CC BY 4.0; под него до сих пор написана большая часть сторонних материалов пятой редакции, и многие столы продолжают играть по этим правилам.',
      'Здесь полный текст 5.1 и отдельная страница для каждого заклинания, монстра, магического предмета, расы, оружия и доспеха. Русский перевод ведётся по тому же словарю, что и наш SRD 5.2.1, — один термин значит одно и то же в обеих редакциях, это удобно, когда за столом смешаны книги 2014 и 2024 годов.',
      'Переходите на правила 2024 года? В SRD 5.2.1 есть гайд по конвертации — он перечисляет, что изменилось между редакциями.',
    ],
  },
  dh: {
    en: [
      'The Daggerheart System Reference Document 1.0 is the open rules text of the Darrington Press game, shared under the Darrington Press Community Gaming License. It holds character creation, the classes and their domains, ancestries and communities, the Duality Dice core mechanic, weapons, armor and loot, the GM guide with adversaries and environments, and the Witherwild campaign frame.',
      'In this reader every adversary, environment, domain card, ancestry and community is a page of its own, with lists by tier, adversary type and domain. The rules text is converted to Markdown unchanged; the Russian translation is ours, built on one glossary of Daggerheart terms.',
      'OmnisGM is not affiliated with or endorsed by Darrington Press; the full attribution and the license are at the foot of every page and on the Legal page.',
    ],
    ru: [
      'Daggerheart System Reference Document 1.0 — открытый текст правил игры Darrington Press, распространяемый по лицензии Darrington Press Community Gaming License. В нём создание персонажа, классы и их домены, происхождения и сообщества, базовая механика Кубиков Двойственности, оружие, броня и добыча, руководство мастера с противниками и окружениями и кампания-рамка Витервилд.',
      'В этом справочнике у каждого противника, окружения, доменной карты, происхождения и сообщества — своя страница; есть списки по рангу, типу противника и домену. Текст правил перенесён в Markdown без изменений, перевод на русский — наш, по единому словарю терминов Daggerheart.',
      'OmnisGM не связан с Darrington Press и не одобрен ею; полная атрибуция и лицензия — внизу каждой страницы и на странице правовой информации.',
    ],
  },
  brp10: {
    en: [
      'Basic Roleplaying is Chaosium’s universal percentile system — the d100 engine behind Call of Cthulhu, RuneQuest and a long line of other games. Its System Reference Document is open under the BRP OGL and covers character creation, the skill system, time and movement, combat and a toolkit of optional spot rules for building your own setting.',
      'Here every skill, profession and spot rule has its own page, and skills are grouped by category, so the reference works as a toolbox rather than a book to read front to back. The Russian translation is ours and follows one glossary of BRP terms.',
      'The BRP logo and the license notice are shown on every page of this section, as the BRP OGL requires.',
    ],
    ru: [
      'Basic Roleplaying — универсальная процентная система Chaosium, d100-движок Call of Cthulhu, RuneQuest и целого ряда других игр. Её System Reference Document открыт по лицензии BRP OGL: создание персонажа, система навыков, время и перемещение, бой и набор необязательных точечных правил для сборки собственного сеттинга.',
      'Здесь у каждого навыка, профессии и точечного правила — своя страница, навыки сгруппированы по категориям: справочник работает как ящик с инструментами, а не как книга, которую читают подряд. Перевод на русский — наш, по единому словарю терминов BRP.',
      'Логотип BRP и уведомление о лицензии стоят на каждой странице раздела, как того требует BRP OGL.',
    ],
  },
};
const about = ABOUT[groupId]?.[lang] ?? [];
const headings = [
  { depth: 2, slug: 'sections', text: t('Разделы', 'Sections') },
  { depth: 2, slug: 'reference', text: t('Справочники', 'Reference') },
];
---
<ReaderShell
  lang={lang}
  currentId={groupId}
  title={title}
  searchTitle={`${sysLabel} ${verLabel}`}
  description={description}
  headings={headings}
  docSource={{ game, version: docSlug.split('/')[1], lang }}
>
  <h1>{heading}</h1>
  <p>{t(
    `Полный текст документа: правила по разделам и справочники сущностей — каждая страница отдельным адресом. Ниже — оглавление ${verLabel}.`,
    `The full document: rules by section plus entity reference compendiums, each entity on its own page. Below is the table of contents for ${verLabel}.`,
  )}</p>
  {about.map((para) => <p>{para}</p>)}

  <h2 id="sections">{t('Разделы', 'Sections')}</h2>
  <ul>
    {chapters.map((node) => isGroup(node) ? (
      <li>
        <strong>{label(node, lang)}</strong>
        <ul>
          {node.kids.filter((k): k is NavPage => !isGroup(k) && !k.hidden).map((k) => (
            <li><a href={routeOf(k.slug, lang)}>{label(k, lang)}</a></li>
          ))}
        </ul>
      </li>
    ) : (
      <li><a href={routeOf((node as NavPage).slug, lang)}>{label(node, lang)}</a></li>
    ))}
  </ul>

  {compendiums.length > 0 && (
    <Fragment>
      <h2 id="reference">{t('Справочники', 'Reference')}</h2>
      <p>{t(
        'Каждая сущность — отдельная страница с фактами из SRD; хаб справочника даёт список целиком и фасеты.',
        'Every entity has its own page with the facts from the SRD; each compendium hub lists them all, with facets.',
      )}</p>
      <ul>
        {compendiums.map((page) => {
          const total = totalOf(page);
          return (
            <li>
              <a href={routeOf(page.slug, lang)}>{label(page, lang)}</a>
              {total ? <span> — {total}</span> : null}
            </li>
          );
        })}
      </ul>
    </Fragment>
  )}
</ReaderShell>

---
import ReaderShell from '../../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../../lib/entities';
import { pageTitle } from '../../../../../../lib/page-title';

// Хаб окружений по рангу (Daggerheart SRD 1.0): /{lang}/daggerheart/{version}/environments/tier/{n}/.
// Все окружения ранга n (1..4) со ссылками на страницы. EN/RU делят числовой слаг → каноникал + hreflang.
const GAME = 'daggerheart';
const PARENT_NAV: Record<string, string> = { srd10: 'dh-environments-hub' };

interface Ent { slug: string; name: string; name_en?: string | null; tier: number }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  const paths = [];
  for (const { ver, lang } of BUILDS) {
    const environments = loadEntities(ver, lang, 'environments', 'daggerheart') as unknown as Ent[];
    const nonEmptyTiers = [1, 2, 3, 4].filter((tier) => environments.some((r) => r.tier === tier));
    for (const tier of [1, 2, 3, 4]) {
      const items = environments.filter((r) => r.tier === tier).sort((a, b) => a.name.localeCompare(b.name));
      if (!items.length) continue;
      paths.push({
        params: { lang, version: VERSION_SLUG[ver], tier: String(tier) },
        props: { ver, lang, tier, items, otherTiers: nonEmptyTiers.filter((n) => n !== tier) },
      });
    }
  }
  return paths;
}

const { ver, lang, tier, items, otherTiers } = Astro.props as {
  ver: string; lang: 'en' | 'ru'; tier: number; items: Ent[]; otherTiers: number[];
};
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);
const base = `/${lang}/${GAME}/${verSlug}/environments`;
const tierLabel = t(`Ранг ${tier}`, `Tier ${tier}`);
const tierLabelFor = (n: number) => t(`Ранг ${n}`, `Tier ${n}`);

const heading = `${tierLabel}${t(' — окружения', ' — Environments')}`;
const title = pageTitle({ name: heading, lang, game: 'daggerheart', version: ver });
const description = t(
  `Все ${items.length} окружений ${tierLabel} в Daggerheart SRD ${verLabel} со ссылками на страницы: сложность, импульсы, противники, особенности.`,
  `All ${items.length} ${tierLabel} environments in Daggerheart SRD ${verLabel} with links to each page: difficulty, impulses, adversaries, features.`,
);
const upLink = { href: `${base}/all/`, ru: 'Все окружения', en: 'All environments' };
---

<ReaderShell
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `${items.length} окружений ${tierLabel} в Daggerheart SRD ${verLabel}. Нажмите, чтобы открыть страницу со стат-блоком.`,
      `${items.length} ${tierLabel} environments in Daggerheart SRD ${verLabel}. Select one to open its stat block page.`,
    )}
  </p>

  <ul class="og-grid">
    {items.map((r) => (
      <li class="og-card">
        <a class="og-card-link" href={`${base}/${r.slug}/`}>{r.name}</a>
        {lang === 'ru' && r.name_en && <span class="og-card-en">{r.name_en}</span>}
      </li>
    ))}
  </ul>

  {otherTiers.length > 0 && (
    <nav class="hub-links" aria-label={t('Другие ранги', 'Other tiers')}>
      <p><strong>{t('Другие ранги:', 'Other tiers:')}</strong>{' '}
        {otherTiers.map((n, i) => (
          <>{i > 0 ? ' · ' : ''}<a href={`${base}/tier/${n}/`}>{tierLabelFor(n)}</a></>
        ))}
      </p>
    </nav>
  )}
</ReaderShell>

<style>
  .og-grid {
    list-style: none; margin: 24px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;
  }
  .og-card {
    display: flex; flex-direction: column; gap: 3px;
    padding: 14px 16px; border: 1px solid var(--og-border); border-radius: 10px;
    background: var(--og-bg-2);
  }
  .og-card-link { font-weight: 600; font-size: 16px; }
  .og-card-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
</style>

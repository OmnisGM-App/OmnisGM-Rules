---
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../lib/entities';
import { pageTitle } from '../../../../../lib/page-title';
import { hubDescription } from '../../../../../lib/entity-facts';
import { countPhrase, countLeadEn, pluralEn } from '../../../../../lib/plural.mjs';

// Хаб-справочник окружений (Daggerheart SRD 1.0): /{lang}/daggerheart/{version}/environments/all/.
// Сортируемая таблица со ссылками на все страницы окружений; «Ранг» ведёт на фасет по рангу.
// Статический роут `all` приоритетнее `[slug]`.
const GAME = 'daggerheart';
const PARENT_NAV: Record<string, string> = { srd10: 'dh-environments-hub' };
const TIERS = [1, 2, 3, 4];

interface Ent { slug: string; name: string; name_en?: string | null; tier: number }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  return BUILDS.map(({ ver, lang }) => ({
    params: { lang, version: VERSION_SLUG[ver] },
    props: { ver, lang, items: loadEntities(ver, lang, 'environments', 'daggerheart') as unknown as Ent[] },
  }));
}

const { ver, lang, items } = Astro.props as { ver: string; lang: 'en' | 'ru'; items: Ent[] };
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);
const base = `/${lang}/${GAME}/${verSlug}/environments`;
const tierLabel = (tier: number) => t(`Ранг ${tier}`, `Tier ${tier}`);
const tierHref = (tier: number) => `${base}/tier/${tier}/`;

const sorted = items.slice().sort((a, b) => a.name.localeCompare(b.name));
const presentTiers = TIERS.filter((tier) => items.some((r) => r.tier === tier));

const heading = t('Окружения', 'Environments');
// Хаб — полный список; MD-глава того же раздела зовётся так же, поэтому в
// <title> отличаем их словом «Все …» (H1 не трогаем).
const title = pageTitle({ name: t('Все окружения', 'All Environments'), lang, game: 'daggerheart', version: ver });
const description = hubDescription({
  base: t(
    `${countPhrase(items.length, lang, ["окружение", "окружения", "окружений"], ["environment", "environments"])} Daggerheart SRD ${verLabel} по рангам (1–4) со ссылками на страницы: сложность, импульсы, противники, особенности.`,
    `${countLeadEn(items.length)} Daggerheart SRD ${verLabel} ${pluralEn(items.length, ["environment", "environments"])} by tier (1–4) with links to each page: difficulty, impulses, adversaries, features.`,
  ),
  names: items.map((e: any) => e.name as string),
  lang,
});
const upLink = { href: `/${lang}/${GAME}/${verSlug}/14_Environments/`, ru: 'Окружения (глава)', en: 'Environments (chapter)' };
---

<ReaderShell
  contentSource={{ game: 'daggerheart', ver, lang, resource: 'environments' }}
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `${items.length} окружений Daggerheart SRD ${verLabel} по рангам. В таблице — ранг (ссылка на список ранга). Общие правила — в главе «Окружения».`,
      `${items.length} Daggerheart SRD ${verLabel} environments by tier. The table lists tier (linked to its list). General rules are in the Environments chapter.`,
    )}
  </p>

  <div class="rd-table-wrap">
    <table class="hub-table" data-sortable>
      <thead>
        <tr>
          <th>{t('Окружение', 'Environment')}</th><th>{t('Ранг', 'Tier')}</th>
          {lang === 'ru' && <th>Оригинал</th>}
        </tr>
      </thead>
      <tbody>
        {sorted.map((r) => (
          <tr>
            <td><a href={`${base}/${r.slug}/`}>{r.name}</a></td>
            <td data-sort={r.tier}><a href={tierHref(r.tier)}>{tierLabel(r.tier)}</a></td>
            {lang === 'ru' && <td class="og-en">{r.name_en ?? '—'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <nav class="hub-links" aria-label={t('Хабы окружений по рангу', 'Environment hubs by tier')}>
    <p><strong>{t('По рангу:', 'By tier:')}</strong>{' '}
      {presentTiers.map((tier, i) => (
        <>{i > 0 ? ' · ' : ''}<a href={tierHref(tier)}>{tierLabel(tier)}</a></>
      ))}
    </p>
  </nav>
</ReaderShell>

<style>
  .og-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
</style>

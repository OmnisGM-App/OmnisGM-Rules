---
import { marked } from 'marked';
import { fromHtml } from 'hast-util-from-html';
import { toHtml } from 'hast-util-to-html';
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { autolinkTree } from '../../../../../lib/rehype-entity-autolink.mjs';
import { highlightKeywords } from '../../../../../lib/keyword-highlight.mjs';
import { glossRules } from '../../../../../lib/rules-gloss.mjs';
import { loadEntities, excerpt, VERSION_SLUG } from '../../../../../lib/entities';
import { pageTitle } from '../../../../../lib/page-title';

// Programmatic-страницы доменных карт (Daggerheart SRD 1.0). URL:
// /{lang}/daggerheart/{version}/domain-cards/{slug}/. EN и RU делят канонический (англ.) слаг →
// корректный hreflang. Полностью независимо от D&D: game=daggerheart, свой бакет данных/hc.
const GAME = 'daggerheart';
const PARENT_NAV: Record<string, string> = { srd10: 'dh-domaincards-hub' };

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  const paths = [];
  for (const { ver, lang } of BUILDS) {
    const cards = loadEntities(ver, lang, 'domain-cards', 'daggerheart');
    const siblings = cards.map((r) => ({ slug: r.slug, name: r.name, domain_slug: r.domain_slug as string }));
    for (const entity of cards) {
      paths.push({
        params: { lang, version: VERSION_SLUG[ver], slug: entity.slug },
        props: { entity, ver, lang, siblings },
      });
    }
  }
  return paths;
}

const { entity, ver, lang, siblings } = Astro.props;
const verSlug = VERSION_SLUG[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);

const tree = fromHtml(marked.parse(entity.description_md ?? '', { async: false }), { fragment: true });
autolinkTree(tree, { game: GAME, version: verSlug, lang, selfSlug: entity.slug });
highlightKeywords(tree, { lang, game: 'daggerheart' });
glossRules(tree, { game: GAME, version: verSlug, lang });
const bodyHtml = toHtml(tree);
const description = excerpt(entity.description_md as string);

const base = `/${lang}/${GAME}/${verSlug}/domain-cards`;
const related = (siblings as { slug: string; name: string; domain_slug: string }[]).filter(
  (s) => s.domain_slug === entity.domain_slug && s.slug !== entity.slug,
);
const upLink = { href: `${base}/all/`, ru: 'Все доменные карты', en: 'All domain cards' };

const kind = t('Доменная карта', 'Domain Card');
const title = pageTitle({ name: entity.name, kind, lang, game: 'daggerheart', version: ver });

const domainHref = `/${lang}/${GAME}/${verSlug}/domain-cards/domain/${entity.domain_slug}/`;
---

<ReaderShell
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={entity.name}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>
    {entity.name}
    {lang === 'ru' && entity.name_en && <span class="ent-en">{entity.name_en}</span>}
  </h1>

  <p class="card-meta">
    {entity.level != null && <>{`${t('Уровень', 'Level')} ${entity.level} · `}</>}
    <a href={domainHref}>{entity.domain}</a>
    {entity.recall_cost != null && <>{` · ${t('Стоимость отзыва', 'Recall Cost')} ${entity.recall_cost}`}</>}
  </p>

  <Fragment set:html={bodyHtml} />

  {related.length > 0 && (
    <nav class="ent-related" aria-label={t(`Другие карты домена ${entity.domain}`, `Other ${entity.domain} cards`)}>
      <span class="ent-related-h">{t(`Другие карты домена ${entity.domain}`, `Other ${entity.domain} cards`)}</span>
      <span class="ent-related-list">
        {related.map((r) => (
          <a href={`${base}/${r.slug}/`}>{r.name}</a>
        ))}
      </span>
    </nav>
  )}
</ReaderShell>

<style>
  .ent-en {
    display: block; margin-top: 8px;
    font-family: var(--font-mono); font-size: 14px; font-weight: 400; letter-spacing: 0;
    color: var(--og-text-muted);
  }
  .card-meta {
    font-size: 14px; color: var(--og-text-muted); margin: 4px 0 20px;
  }
  .card-meta a { color: var(--og-text-muted); text-decoration: underline; }
  .card-meta a:hover { color: var(--og-text); }
  .ent-related { display: block; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--og-border); }
  .ent-related-h {
    display: block; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;
    color: var(--og-text-muted); margin-bottom: 10px;
  }
  .ent-related-list { display: flex; flex-wrap: wrap; gap: 6px 14px; }
</style>

---
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../lib/entities';

// Хаб-справочник доменных карт (Daggerheart SRD 1.0): /{lang}/daggerheart/{version}/domain-cards/all/.
// Единая сортируемая таблица (карта · домен · уровень · стоимость отзыва); «Домен» ведёт на
// фасет по домену. Статический роут `all` приоритетнее `[slug]`.
const GAME = 'daggerheart';
const PARENT_NAV: Record<string, string> = { srd10: 'dh-domaincards-hub' };
const DOMAINS = ['arcana', 'blade', 'bone', 'codex', 'grace', 'midnight', 'sage', 'splendor', 'valor'];

interface Card {
  slug: string;
  name: string;
  name_en?: string | null;
  domain: string;
  domain_en?: string | null;
  domain_slug: string;
  level: number | null;
  recall_cost: number | null;
}

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  return BUILDS.map(({ ver, lang }) => ({
    params: { lang, version: VERSION_SLUG[ver] },
    props: { ver, lang, items: loadEntities(ver, lang, 'domain-cards', 'daggerheart') as unknown as Card[] },
  }));
}

const { ver, lang, items } = Astro.props as { ver: string; lang: 'en' | 'ru'; items: Card[] };
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);
const base = `/${lang}/${GAME}/${verSlug}/domain-cards`;

const sorted = items.slice().sort((a, b) => a.name.localeCompare(b.name));
// Домены, реально присутствующие среди карт (порядок фиксирован DOMAINS) + их локализованное имя.
const domainList = DOMAINS
  .map((domainSlug) => {
    const sample = items.find((c) => c.domain_slug === domainSlug);
    return sample ? { domainSlug, domainName: sample.domain } : null;
  })
  .filter((d): d is { domainSlug: string; domainName: string } => d !== null);

const heading = t('Доменные карты', 'Domain Cards');
const title = `${heading} — Daggerheart ${verLabel} · OmnisGM Rules`;
const description = t(
  `Все ${items.length} доменных карт Daggerheart ${verLabel} в 9 доменах со ссылками на страницы карт.`,
  `All ${items.length} Daggerheart ${verLabel} domain cards across 9 domains with links to each card.`,
);
const upLink = { href: `/${lang}/${GAME}/${verSlug}/16_DomainCardReference/`, ru: 'Справочник доменных карт (глава)', en: 'Domain Card Reference (chapter)' };
---

<ReaderShell
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `${items.length} доменных карт Daggerheart ${verLabel}. В таблице — домен (ссылка на список домена), уровень и стоимость отзыва.`,
      `${items.length} Daggerheart ${verLabel} domain cards. The table lists domain (linked to its list), level and recall cost.`,
    )}
  </p>

  <div class="rd-table-wrap">
    <table class="hub-table" data-sortable>
      <thead>
        <tr>
          <th>{t('Карта', 'Card')}</th><th>{t('Домен', 'Domain')}</th>
          <th>{t('Уровень', 'Level')}</th><th>{t('Отзыв', 'Recall')}</th>
          {lang === 'ru' && <th>Оригинал</th>}
        </tr>
      </thead>
      <tbody>
        {sorted.map((c) => (
          <tr>
            <td><a href={`${base}/${c.slug}/`}>{c.name}</a></td>
            <td><a href={`${base}/domain/${c.domain_slug}/`}>{c.domain}</a></td>
            <td data-sort={c.level ?? 999}>{c.level ?? '—'}</td>
            <td data-sort={c.recall_cost ?? 999}>{c.recall_cost ?? '—'}</td>
            {lang === 'ru' && <td class="og-en">{c.name_en ?? '—'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <nav class="hub-links" aria-label={t('Хабы доменных карт по домену', 'Domain card hubs by domain')}>
    <p><strong>{t('По домену:', 'By domain:')}</strong>{' '}
      {domainList.map((d, i) => (
        <>{i > 0 ? ' · ' : ''}<a href={`${base}/domain/${d.domainSlug}/`}>{d.domainName}</a></>
      ))}
    </p>
  </nav>
</ReaderShell>

<style>
  .og-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
</style>

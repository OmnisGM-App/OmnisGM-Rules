---
import ReaderShell from '../../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../../lib/entities';
import { pageTitle } from '../../../../../../lib/page-title';
import { hubDescription } from '../../../../../../lib/entity-facts';
import { countPhrase, countLeadEn, pluralEn } from '../../../../../../lib/plural.mjs';

// Фасет противников по рангу (Daggerheart SRD 1.0): /{lang}/daggerheart/{version}/adversaries/tier/{n}/.
// Ловит «tier 1 adversaries daggerheart» / «противники ранга 1». EN/RU делят числовой слаг →
// каноникал + hreflang.
const GAME = 'daggerheart';
const PARENT_NAV: Record<string, string> = { srd10: 'dh-adversaries-hub' };
const TIERS = [1, 2, 3, 4] as const;

interface Ent { slug: string; name: string; name_en?: string | null; tier: number }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  const paths = [];
  for (const { ver, lang } of BUILDS) {
    const adversaries = loadEntities(ver, lang, 'adversaries', 'daggerheart') as unknown as Ent[];
    for (const tier of [1, 2, 3, 4]) {
      const items = adversaries.filter((r) => r.tier === tier).sort((a, b) => a.name.localeCompare(b.name));
      if (!items.length) continue;
      paths.push({
        params: { lang, version: VERSION_SLUG[ver], tier: String(tier) },
        props: { ver, lang, tier, items },
      });
    }
  }
  return paths;
}

const { ver, lang, tier, items } = Astro.props as {
  ver: string; lang: 'en' | 'ru'; tier: number; items: Ent[];
};
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);
const base = `/${lang}/${GAME}/${verSlug}/adversaries`;
const tierLabel = t(`Ранг ${tier}`, `Tier ${tier}`);

const heading = `${tierLabel}${t(' — противники', ' — Adversaries')}`;
const title = pageTitle({ name: heading, lang, game: 'daggerheart', version: ver });
const description = hubDescription({
  base: t(
    `${countPhrase(items.length, lang, ["противник", "противника", "противников"], ["adversary", "adversaries"])} ${tierLabel} в Daggerheart SRD ${verLabel} со ссылками на стат-блоки: мотивы, сложность, атаки и способности.`,
    `${countLeadEn(items.length)} ${tierLabel} ${pluralEn(items.length, ["adversary", "adversaries"])} in Daggerheart SRD ${verLabel} with links to each stat block: motives, difficulty, attacks and features.`,
  ),
  names: items.map((e: any) => e.name as string),
  lang,
});
const otherTiers = TIERS.filter((n) => n !== tier);
const upLink = { href: `${base}/all/`, ru: 'Все противники', en: 'All adversaries' };
---

<ReaderShell
  contentSource={{ game: 'daggerheart', ver, lang, resource: 'adversaries' }}
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `${items.length} противников ${tierLabel} в Daggerheart SRD ${verLabel}. Нажмите на имя, чтобы открыть стат-блок.`,
      `${items.length} ${tierLabel} adversaries in Daggerheart SRD ${verLabel}. Select a name to open its stat block.`,
    )}
  </p>

  <ul class="og-grid">
    {items.map((r) => (
      <li class="og-card">
        <a class="og-card-link" href={`${base}/${r.slug}/`}>{r.name}</a>
        {lang === 'ru' && r.name_en && <span class="og-card-en">{r.name_en}</span>}
      </li>
    ))}
  </ul>

  <nav class="hub-links" aria-label={t('Другие ранги', 'Other tiers')}>
    <p><strong>{t('Другие ранги:', 'Other tiers:')}</strong>{' '}
      {otherTiers.map((n, i) => (
        <>{i > 0 ? ' · ' : ''}<a href={`${base}/tier/${n}/`}>{t(`Ранг ${n}`, `Tier ${n}`)}</a></>
      ))}
    </p>
  </nav>
</ReaderShell>

<style>
  .og-grid {
    list-style: none; margin: 24px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;
  }
  .og-card {
    display: flex; flex-direction: column; gap: 3px;
    padding: 14px 16px; border: 1px solid var(--og-border); border-radius: 10px;
    background: var(--og-bg-2);
  }
  .og-card-link { font-weight: 600; font-size: 16px; }
  .og-card-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
</style>

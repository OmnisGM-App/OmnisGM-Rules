---
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../lib/entities';
import { pageTitle } from '../../../../../lib/page-title';
import { hubDescription } from '../../../../../lib/entity-facts';
import { countPhrase, countLeadEn, pluralEn } from '../../../../../lib/plural.mjs';

// Хаб-справочник сообществ (Daggerheart SRD 1.0): /{lang}/daggerheart/{version}/communities/all/.
// Сортируемая таблица со ссылками на все страницы сообществ. Статический роут `all` приоритетнее `[slug]`.
const GAME = 'daggerheart';
const PARENT_NAV: Record<string, string> = { srd10: 'dh-communities-hub' };

interface Ent { slug: string; name: string; name_en?: string | null }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  return BUILDS.map(({ ver, lang }) => ({
    params: { lang, version: VERSION_SLUG[ver] },
    props: {
      ver, lang,
      items: (loadEntities(ver, lang, 'communities', 'daggerheart') as unknown as Ent[])
        .slice().sort((a, b) => a.name.localeCompare(b.name)),
    },
  }));
}

const { ver, lang, items } = Astro.props as { ver: string; lang: 'en' | 'ru'; items: Ent[] };
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);
const base = `/${lang}/${GAME}/${verSlug}/communities`;

const heading = t('Сообщества', 'Communities');
// Хаб — полный список; MD-глава того же раздела зовётся так же, поэтому в
// <title> отличаем их словом «Все …» (H1 не трогаем).
const title = pageTitle({ name: t('Все сообщества', 'All Communities'), lang, game: 'daggerheart', version: ver });
const description = hubDescription({
  base: t(
    `${countPhrase(items.length, lang, ["сообщество", "сообщества", "сообществ"], ["community", "communities"])} Daggerheart SRD ${verLabel} со ссылками на страницы: особенность сообщества.`,
    `${countLeadEn(items.length)} Daggerheart SRD ${verLabel} ${pluralEn(items.length, ["community", "communities"])} with links to each page: community feature.`,
  ),
  names: items.map((e: any) => e.name as string),
  lang,
});
const upLink = { href: `/${lang}/${GAME}/${verSlug}/06_Communities/`, ru: 'Сообщества (глава)', en: 'Communities (chapter)' };
---

<ReaderShell
  contentSource={{ game: 'daggerheart', ver, lang, resource: 'communities' }}
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `${items.length} сообществ Daggerheart SRD ${verLabel}. Нажмите на название, чтобы открыть страницу с особенностью. Общие правила — в главе «Сообщества».`,
      `${items.length} Daggerheart SRD ${verLabel} communities. Select a name to open its page with its feature. General rules are in the Communities chapter.`,
    )}
  </p>

  <div class="rd-table-wrap">
    <table class="hub-table" data-sortable>
      <thead>
        <tr><th>{t('Сообщество', 'Community')}</th>{lang === 'ru' && <th>Оригинал</th>}</tr>
      </thead>
      <tbody>
        {items.map((r) => (
          <tr>
            <td><a href={`${base}/${r.slug}/`}>{r.name}</a></td>
            {lang === 'ru' && <td class="og-en">{r.name_en ?? '—'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</ReaderShell>

<style>
  .og-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
</style>

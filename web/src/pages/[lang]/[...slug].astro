---
import { getCollection, render } from 'astro:content';
import ReaderShell from '../../components/ReaderShell.astro';
import { parseId, titleFromBody } from '../../lib/slug';
import { nodeBySlug, findPath, label as navLabel } from '../../lib/nav';
import { classDescription } from '../../lib/class-facts';
import { pageDescription } from '../../lib/page-description.mjs';
import { pageTitle } from '../../lib/page-title';
import { hostingRedirects, isRedirected } from '../../lib/hosting-redirects.mjs';
import { entityImage } from '../../lib/entity-image.mjs';
import DocHero from '../../components/DocHero.astro';
import DreadDiceCalc from '../../components/DreadDiceCalc.astro';

export async function getStaticPaths() {
  const all = await getCollection('srd');
  const redirects = hostingRedirects();
  return all
    // Заглушки обзора глав (напр. 06_Classes/00_Classes.md = только «# Classes») нужны контентному
    // пайплайну для PDF, но на сайте это пустая тонкая страница — роут не генерим (см. #17).
    .filter((entry) => !/\/\d+_Classes\/00_Classes$/.test(entry.id))
    // Адрес, который хостинг уводит 301 на хаб (дубли глоссариев, #160/#163), на проде недостижим —
    // страницу не собираем (#399): иначе она живёт только в dist, вне навигации и с сырым заголовком.
    .filter((entry) => {
      const ref = parseId(entry.id);
      return !isRedirected(`/${ref.lang}/${ref.game}/${ref.version}/${ref.slug}/`, redirects);
    })
    .map((entry) => {
    const ref = parseId(entry.id);
    return {
      params: { lang: ref.lang, slug: `${ref.game}/${ref.version}/${ref.slug}` },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const ref = parseId(entry.id);
const { Content, headings } = await render(entry);

const curSlug = `${ref.game}/${ref.version}/${ref.slug}`;
const navNode = nodeBySlug(curSlug);
const currentId = navNode?.id ?? curSlug;

// Чистый заголовок страницы (и для <title>, и для Pagefind): подпись из nav — надёжнее h1/слага.
// У хоумбрю подпись в nav несёт пометку «(хоумбрю)», а тип страницы и так стоит в <title>.
const homebrewPage = ref.game === 'dnd' && ref.version === 'homebrew';
const searchTitle = homebrewPage
  ? (titleFromBody(entry.body) || ref.slug)
  : navNode ? navLabel(navNode, ref.lang) : (titleFromBody(entry.body) || ref.slug);
const trail = findPath(currentId) ?? [];
const sysLabel = trail.length ? navLabel(trail[0], ref.lang) : ref.game.toUpperCase();
const verLabel = trail.length > 1 ? navLabel(trail[1], ref.lang) : ref.version;
// В сниппет — только номер документа: редакцию description называет своими словами (#185).
const docLabel = verLabel.replace(/\s*\(.*\)$/, '');

const t = (ru: string, en: string) => (ref.lang === 'en' ? en : ru);

// Класс-страницы — самый крупный кластер кириллического спроса («плут днд», issue #173).
const isClass = ref.game === 'dnd' && ref.slug.startsWith('classes/');

// Тип страницы для <title> (issue #185): лицензию не называем никак — это не правила.
const isLegal = /(^|\/)legal(\/|$)/i.test(ref.slug);
const mdKind = ref.game !== 'dnd' || isLegal ? '' : homebrewPage ? t('хоумбрю', 'homebrew') : isClass ? t('класс', 'class') : t('правила', 'rules');
const isDreadDice = homebrewPage && ref.slug === 'dread-dice';
const hero = homebrewPage ? entityImage('dnd', 'homebrew', ref.slug) : null;
const HERO_W = 1200;
const HERO_H = 630;
const title = pageTitle({
  name: searchTitle, kind: mdKind, lang: ref.lang, game: ref.game, version: ref.version,
});

// H1, если его нет в markdown (issue #228): .md глоссарных хабов начинается с таблицы.
// Правим в шаблоне, а не в контенте — правка импорта SRD не пережила бы переимпорт.
const needsHeading = !headings.some((h) => h.depth === 1);

const HOMEBREW_DESCRIPTION: Record<string, { ru: string; en: string }> = {
  'dread-dice': {
    ru: 'Кубы угрозы — хоумбрю OmnisGM для D&D 5e (2014 и 2024): мешок светлых и тёмных d20, растущий порог угрозы и калькулятор шансов.',
    en: 'Dread Dice — OmnisGM homebrew for D&D 5e (2014 and 2024): a bag of light and dark d20s, a rising threat threshold and an odds calculator.',
  },
};
const homebrewDescription = homebrewPage ? HOMEBREW_DESCRIPTION[ref.slug] : undefined;
const description = homebrewDescription ? t(homebrewDescription.ru, homebrewDescription.en) :
  (isClass
    ? classDescription({ name: searchTitle, body: entry.body, lang: ref.lang, version: ref.version, verLabel: docLabel })
    : null) ??
  pageDescription({ name: searchTitle, body: entry.body, lang: ref.lang, sysLabel, docLabel });
---
<ReaderShell
  lang={ref.lang}
  currentId={currentId}
  title={title}
  searchTitle={searchTitle}
  description={description}
  headings={headings}
  sourceId={entry.id}
  image={hero ?? undefined}
  imageWidth={hero ? HERO_W : undefined}
  imageHeight={hero ? HERO_H : undefined}
>
  {hero && <DocHero image={hero} alt={searchTitle} width={HERO_W} height={HERO_H} />}
  {needsHeading && <h1>{searchTitle}</h1>}
  <Content />
  {isDreadDice && <DreadDiceCalc lang={ref.lang} />}
</ReaderShell>

---
import { getCollection, render } from 'astro:content';
import ReaderShell from '../../components/ReaderShell.astro';
import { parseId, titleFromBody } from '../../lib/slug';
import { nodeBySlug, findPath, label as navLabel } from '../../lib/nav';
import { classDescription } from '../../lib/class-facts';
import { pageTitle } from '../../lib/page-title';

export async function getStaticPaths() {
  const all = await getCollection('srd');
  return all
    // Заглушки обзора глав (напр. 06_Classes/00_Classes.md = только «# Classes») нужны контентному
    // пайплайну для PDF, но на сайте это пустая тонкая страница — роут не генерим (см. #17).
    .filter((entry) => !/\/\d+_Classes\/00_Classes$/.test(entry.id))
    .map((entry) => {
    const ref = parseId(entry.id);
    return {
      params: { lang: ref.lang, slug: `${ref.game}/${ref.version}/${ref.slug}` },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const ref = parseId(entry.id);
const { Content, headings } = await render(entry);

const curSlug = `${ref.game}/${ref.version}/${ref.slug}`;
const navNode = nodeBySlug(curSlug);
const currentId = navNode?.id ?? curSlug;

// Чистый заголовок страницы (и для <title>, и для Pagefind): подпись из nav — надёжнее h1/слага.
// На глоссарных страницах titleFromBody падает в слаг типа «glossary/magic-items», что лезло
// прямо в <title> и в выдачу Google. Nav-подпись локализована и всегда опрятна; слаг — лишь фолбэк.
const searchTitle = navNode ? navLabel(navNode, ref.lang) : (titleFromBody(entry.body) || ref.slug);
const trail = findPath(currentId) ?? [];
const sysLabel = trail.length ? navLabel(trail[0], ref.lang) : ref.game.toUpperCase();
const verLabel = trail.length > 1 ? navLabel(trail[1], ref.lang) : ref.version;

const t = (ru: string, en: string) => (ref.lang === 'en' ? en : ru);

// Класс-страницы (напр. /classes/rogue/) — самый крупный кластер кириллического спроса
// («плут днд»: 513 запросов, issue #173). Отсюда и отдельный тип в <title>, и содержательный
// сниппет из умений 1-го уровня вместо бойлерплейта.
const isClass = ref.game === 'dnd' && ref.slug.startsWith('classes/');

// Тип страницы для <title> (issue #185). Прежний шаблон «Плут · D&D SRD 5.2.1 · OmnisGM Rules»
// не содержал ни типа сущности, ни формы «днд» — а по «плут днд» это ~280 показов/нед при
// нулевом CTR. Классы называем классами, остальные главы — правилами; лицензию не называем
// никак (это не правила). Не-D&D системы идут через тот же шаблон, но без «днд» —
// кириллического кластера у Daggerheart/BRP нет (см. searchForm в page-title.ts).
const isLegal = /(^|\/)legal(\/|$)/i.test(ref.slug);
const mdKind = ref.game !== 'dnd' || isLegal ? '' : isClass ? t('класс', 'class') : t('правила', 'rules');
const title = pageTitle({
  name: searchTitle, kind: mdKind, lang: ref.lang, game: ref.game, version: ref.version,
});

const description =
  (isClass
    ? classDescription({ name: searchTitle, body: entry.body, lang: ref.lang, version: ref.version, verLabel })
    : null) ??
  t(
    `${searchTitle} — ${sysLabel} ${verLabel} на русском. SRD настольных ролевых игр в экосистеме OmnisGM.`,
    `${searchTitle} — ${sysLabel} ${verLabel}. Tabletop RPG System Reference Document in the OmnisGM ecosystem.`,
  );
---
<ReaderShell
  lang={ref.lang}
  currentId={currentId}
  title={title}
  searchTitle={searchTitle}
  description={description}
  headings={headings}
  sourceId={entry.id}
>
  <Content />
</ReaderShell>

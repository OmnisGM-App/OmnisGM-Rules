---
import { getCollection, render } from 'astro:content';
import ReaderShell from '../../components/ReaderShell.astro';
import { parseId, titleFromBody } from '../../lib/slug';
import { nodeBySlug, findPath, label as navLabel } from '../../lib/nav';
import { classDescription } from '../../lib/class-facts';
import { pageDescription } from '../../lib/page-description.mjs';
import { pageTitle } from '../../lib/page-title';

export async function getStaticPaths() {
  const all = await getCollection('srd');
  return all
    // Заглушки обзора глав (напр. 06_Classes/00_Classes.md = только «# Classes») нужны контентному
    // пайплайну для PDF, но на сайте это пустая тонкая страница — роут не генерим (см. #17).
    .filter((entry) => !/\/\d+_Classes\/00_Classes$/.test(entry.id))
    .map((entry) => {
    const ref = parseId(entry.id);
    return {
      params: { lang: ref.lang, slug: `${ref.game}/${ref.version}/${ref.slug}` },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const ref = parseId(entry.id);
const { Content, headings } = await render(entry);

const curSlug = `${ref.game}/${ref.version}/${ref.slug}`;
const navNode = nodeBySlug(curSlug);
const currentId = navNode?.id ?? curSlug;

// Чистый заголовок страницы (и для <title>, и для Pagefind): подпись из nav — надёжнее h1/слага.
const searchTitle = navNode ? navLabel(navNode, ref.lang) : (titleFromBody(entry.body) || ref.slug);
const trail = findPath(currentId) ?? [];
const sysLabel = trail.length ? navLabel(trail[0], ref.lang) : ref.game.toUpperCase();
const verLabel = trail.length > 1 ? navLabel(trail[1], ref.lang) : ref.version;
// В сниппет — только номер документа: редакцию description называет своими словами (#185).
const docLabel = verLabel.replace(/\s*\(.*\)$/, '');

const t = (ru: string, en: string) => (ref.lang === 'en' ? en : ru);

// Класс-страницы — самый крупный кластер кириллического спроса («плут днд», issue #173).
const isClass = ref.game === 'dnd' && ref.slug.startsWith('classes/');

// Тип страницы для <title> (issue #185): лицензию не называем никак — это не правила.
const isLegal = /(^|\/)legal(\/|$)/i.test(ref.slug);
const mdKind = ref.game !== 'dnd' || isLegal ? '' : isClass ? t('класс', 'class') : t('правила', 'rules');
const title = pageTitle({
  name: searchTitle, kind: mdKind, lang: ref.lang, game: ref.game, version: ref.version,
});

// H1, если его нет в markdown (issue #228): .md глоссарных хабов начинается с таблицы.
// Правим в шаблоне, а не в контенте — правка импорта SRD не пережила бы переимпорт.
const needsHeading = !headings.some((h) => h.depth === 1);

const description =
  (isClass
    ? classDescription({ name: searchTitle, body: entry.body, lang: ref.lang, version: ref.version, verLabel: docLabel })
    : null) ??
  pageDescription({ name: searchTitle, body: entry.body, lang: ref.lang, sysLabel, docLabel });
---
<ReaderShell
  lang={ref.lang}
  currentId={currentId}
  title={title}
  searchTitle={searchTitle}
  description={description}
  headings={headings}
  sourceId={entry.id}
>
  {needsHeading && <h1>{searchTitle}</h1>}
  <Content />
</ReaderShell>

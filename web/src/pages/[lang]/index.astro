---
import ReaderShell from '../../components/ReaderShell.astro';
import HomeAbout from '../../components/HomeAbout.astro';
import { nodeById, routeOf, isGroup, type Lang } from '../../lib/nav';

export async function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ru' } }];
}

const lang = Astro.params.lang as Lang;
const t = (ru: string, en: string) => (lang === 'en' ? en : ru);

const REPO = 'https://github.com/OmnisGM-App/OmnisGM-Rules';
const ISSUE = `${REPO}/issues/new`;

// Маршрут на первую страницу версии (Legal) / документа
const r = (id: string) => {
  const n = nodeById(id);
  return n && !isGroup(n) ? routeOf(n.slug, lang) : `/${lang}`;
};

const title = t('Главная · OmnisGM Rules', 'Home · OmnisGM Rules');
const description = t(
  'SRD настольных ролевых игр на русском: D&D 5.2.1 и 5.1, Daggerheart, Basic Roleplaying — полный перевод правил и страница на каждое заклинание и монстра.',
  'Read the D&D 5.2.1 and 5.1, Daggerheart and Basic Roleplaying SRDs online: every rules section, thousands of entity pages, each with a Russian twin.',
);

// Заголовки для TOC (контент авторский, не из Markdown)
const headings = [
  { depth: 2, slug: 'dnd', text: 'Dungeons & Dragons' },
  { depth: 2, slug: 'daggerheart', text: 'Daggerheart SRD' },
  { depth: 2, slug: 'brp', text: 'Basic Roleplaying' },
  { depth: 2, slug: 'about', text: t('О справочнике', 'About') },
];
---
<ReaderShell lang={lang} currentId="home" title={title} description={description} headings={headings}>
  <h1 id="ttrpg-srd">{t('OmnisGM Rules — справочник настольных ролёвок', 'OmnisGM Rules — tabletop RPG reference')}</h1>
  <p>
    {t(
      'Свободно доступные System Reference Document, собранные в одном месте, в Markdown. Читайте онлайн или берите исходный текст.',
      'Freely-licensed System Reference Documents, gathered in one place, as Markdown. Read online or take the source text.',
    )}
  </p>

  <h2 id="dnd">Dungeons &amp; Dragons</h2>
  <ul>
    <li><a href={r('d52-legal')}><strong>SRD 5.2.1</strong></a> — {t('базовые правила D&D 5e (2024): классы, заклинания, монстры, магические предметы, снаряжение. Лицензия CC BY 4.0.', 'the core rules of D&D 5e (2024): classes, spells, monsters, magic items, equipment. CC BY 4.0.')}</li>
    <li><a href={r('d51-legal')}><strong>SRD 5.1</strong></a> — {t('базовые правила D&D 5e (2014). Лицензия CC BY 4.0.', 'the core rules of D&D 5e (2014). CC BY 4.0.')}</li>
    <li><a href={r('d52-converting')}><strong>{t('Конвертация в SRD 5.2.1', 'Converting to SRD 5.2.1')}</strong></a> — {t('гайд по переходу с 5.1 на 5.2.1.', 'a guide to moving from 5.1 to 5.2.1.')}</li>
  </ul>

  <h2 id="daggerheart">Daggerheart SRD</h2>
  <ul>
    <li><a href={r('dh-legal')} aria-label="Daggerheart SRD 1.0"><strong>SRD 1.0</strong></a> — {t('правила Daggerheart SRD 1.0: классы, домены, происхождения, противники, оружие, броня. Лицензия DPCGL. © 2025 Critical Role LLC.', 'the Daggerheart SRD 1.0 rules: classes, domains, ancestries, adversaries, weapons, armor. DPCGL. © 2025 Critical Role LLC.')}</li>
  </ul>

  <h2 id="brp">Basic Roleplaying</h2>
  <ul>
    <li><a href={r('brp-legal')} aria-label="Basic Roleplaying SRD 1.0"><strong>SRD 1.0</strong></a> — {t('универсальная d100-система от Chaosium (ядро Call of Cthulhu, RuneQuest и др.). Лицензия BRP OGL.', 'Chaosium’s universal d100 system (the engine behind Call of Cthulhu, RuneQuest and more). BRP OGL.')}</li>
  </ul>

  <HomeAbout lang={lang} />

  <hr />
  <blockquote>
    {t('Нашли ошибку — ', 'Found an error? ')}
    <a href={ISSUE} target="_blank" rel="noopener">{t('создайте issue', 'Open an issue')}</a>
    {t(' в репозитории проекта.', ' in the project repository.')}
  </blockquote>
</ReaderShell>

---
import { marked } from 'marked';
import { fromHtml } from 'hast-util-from-html';
import { toHtml } from 'hast-util-to-html';
import ReaderShell from '../../../../../../components/ReaderShell.astro';
import RulesTermEntry from '../../../../../../components/RulesTermEntry.astro';
import { autolinkTree } from '../../../../../../lib/rehype-entity-autolink.mjs';
import { sourceLinkFor } from '../../../../../../lib/rules-glossary-source.mjs';
import { loadEntities, excerpt, VERSION_SLUG } from '../../../../../../lib/entities';
import { pageTitle } from '../../../../../../lib/page-title';

// Programmatic-страницы состояний (issue #20, волна 1) в общем шелле ридера.
// URL вложен под главу-родителя: /{lang}/dnd/{version}/rules-glossary/conditions/{slug}/.
// EN и RU делят канонический (английский) слаг → корректный hreflang (ReaderShell считает его из URL).

// Nav-узел главы-родителя по версии (для подсветки дерева, breadcrumb, prev/next, CTA-атрибуции).
const PARENT_NAV: Record<string, string> = { srd52: 'd52-rulesglossary', srd51: 'd51-conditions' };

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd52', lang: 'en' as const },
    { ver: 'srd52', lang: 'ru' as const },
    { ver: 'srd51', lang: 'en' as const },
    { ver: 'srd51', lang: 'ru' as const },
  ];
  const paths = [];
  for (const { ver, lang } of BUILDS) {
    const conditions = loadEntities(ver, lang, 'conditions');
    const siblings = conditions.map((c) => ({ slug: c.slug, name: c.name }));
    for (const entity of conditions) {
      paths.push({
        params: { lang, version: VERSION_SLUG[ver], slug: entity.slug },
        props: { entity, ver, lang, siblings },
      });
    }
  }
  return paths;
}

const { entity, ver, lang, siblings } = Astro.props;
const verSlug = VERSION_SLUG[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);

// Автоссылки на другие состояния прямо в теле (issue #20): marked → hast → autolink → html.
const rawHtml = marked.parse(entity.description_md ?? '', { async: false });
const tree = fromHtml(rawHtml, { fragment: true });
autolinkTree(tree, { game: 'dnd', version: verSlug, lang, selfSlug: entity.slug });
const bodyHtml = toHtml(tree);
const description = excerpt(entity.description_md);
// Ссылка-источник в главу (#106) — карта глав 5.2-специфична, поэтому только srd52.
const source = ver === 'srd52' ? sourceLinkFor(entity.description_md, { verSlug, lang }) : null;

const base = `/${lang}/dnd/${verSlug}/rules-glossary/conditions`;
const related = siblings.filter((s: { slug: string }) => s.slug !== entity.slug);

// Кнопка «в раздел» (центр ряда prev/next) → родительская глава-глоссарий, откуда состояния.
const upLink = {
  href: `/${lang}/dnd/${verSlug}/rules-glossary/`,
  ru: 'Глоссарий правил',
  en: 'Rules Glossary',
};

const kind = t('Состояние', 'Condition');
const title = pageTitle({ name: entity.name, kind, lang, game: 'dnd', version: ver });
---

<ReaderShell
  contentSource={{ game: 'dnd', ver, lang, resource: 'conditions' }}
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={entity.name}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <RulesTermEntry
    name={entity.name}
    nameEn={entity.name_en}
    lang={lang}
    bodyHtml={bodyHtml}
    source={source}
    related={related}
    relatedBase={base}
    relatedLabel={t('Другие состояния', 'Other conditions')}
  />
</ReaderShell>

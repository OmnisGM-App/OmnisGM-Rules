---
import { marked } from 'marked';
import ReaderShell from '../../../../../../components/ReaderShell.astro';
import { loadEntities, excerpt, VERSION_SLUG, VERSION_LABEL } from '../../../../../../lib/entities';

// Programmatic-страницы состояний (issue #20, волна 1) в общем шелле ридера.
// URL вложен под главу-родителя: /{lang}/dnd/{version}/rules-glossary/conditions/{slug}/.
// EN и RU делят канонический (английский) слаг → корректный hreflang (ReaderShell считает его из URL).

// Nav-узел главы-родителя по версии (для подсветки дерева, breadcrumb, prev/next, CTA-атрибуции).
const PARENT_NAV: Record<string, string> = { srd52: 'd52-rulesglossary' };

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd52', lang: 'en' as const },
    { ver: 'srd52', lang: 'ru' as const },
  ];
  const paths = [];
  for (const { ver, lang } of BUILDS) {
    const conditions = loadEntities(ver, lang, 'conditions');
    const siblings = conditions.map((c) => ({ slug: c.slug, name: c.name }));
    for (const entity of conditions) {
      paths.push({
        params: { lang, version: VERSION_SLUG[ver], slug: entity.slug },
        props: { entity, ver, lang, siblings },
      });
    }
  }
  return paths;
}

const { entity, ver, lang, siblings } = Astro.props;
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);

const bodyHtml = marked.parse(entity.description_md ?? '', { async: false });
const description = excerpt(entity.description_md);

const base = `/${lang}/dnd/${verSlug}/rules-glossary/conditions`;
const related = siblings.filter((s) => s.slug !== entity.slug);

// Кнопка «в раздел» (центр ряда prev/next) → родительская глава-глоссарий, откуда состояния.
const upLink = {
  href: `/${lang}/dnd/${verSlug}/rules-glossary/`,
  ru: 'Глоссарий правил',
  en: 'Rules Glossary',
};

const kind = t('Состояние', 'Condition');
const title = `${entity.name} — ${t(`${kind} D&D ${verLabel}`, `D&D ${verLabel} ${kind}`)} · OmnisGM Rules`;
---

<ReaderShell
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={entity.name}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>
    {entity.name}
    {lang === 'ru' && entity.name_en && <span class="ent-en">{entity.name_en}</span>}
  </h1>

  <Fragment set:html={bodyHtml} />

  {related.length > 0 && (
    <nav class="ent-related" aria-label={t('Другие состояния', 'Other conditions')}>
      <span class="ent-related-h">{t('Другие состояния', 'Other conditions')}</span>
      <span class="ent-related-list">
        {related.map((r) => (
          <a href={`${base}/${r.slug}/`}><strong>{r.name}</strong></a>
        ))}
      </span>
    </nav>
  )}
</ReaderShell>

<style>
  /* Оригинальное (англ.) название — ВНУТРИ h1, над её нижней границей (чертой).
     Прямые правила на .ent-en бьют наследование от h1 при любой стратегии скоупинга,
     поэтому specificity-война с `.rd-doc h1` не нужна. */
  .ent-en {
    display: block;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--og-text-muted);
  }
  .ent-related {
    display: block;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--og-border);
  }
  .ent-related-h {
    display: block;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--og-text-muted);
    margin-bottom: 10px;
  }
  .ent-related-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }
  /* Ссылки — как на главной: <a><strong>…</strong></a>. Цвет текста даёт .rd-doc strong
     (белый), подчёркивание — .rd-doc a (фиолетовый border-bottom). Через разметку, а не
     scoped-CSS: Astro скоупит через :where() (нулевая специфичность) и проигрывает .rd-doc a. */
</style>

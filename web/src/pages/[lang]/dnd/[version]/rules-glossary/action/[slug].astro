---
import { marked } from 'marked';
import { fromHtml } from 'hast-util-from-html';
import { toHtml } from 'hast-util-to-html';
import ReaderShell from '../../../../../../components/ReaderShell.astro';
import RulesTermEntry from '../../../../../../components/RulesTermEntry.astro';
import { autolinkTree } from '../../../../../../lib/rehype-entity-autolink.mjs';
import { sourceLinkFor } from '../../../../../../lib/rules-glossary-source.mjs';
import { loadEntities, excerpt, VERSION_SLUG } from '../../../../../../lib/entities';
import { pageTitle } from '../../../../../../lib/page-title';

// Programmatic-страницы действий Rules Glossary (issue #106): Рывок/Уклонение/Засада/…
// URL /{lang}/dnd/{version}/rules-glossary/action/{slug}/. Зеркалит состояния; малый набор →
// показываем список родственных действий.
const PARENT_NAV: Record<string, string> = { srd52: 'd52-rulesterms-hub' };

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd52', lang: 'en' as const },
    { ver: 'srd52', lang: 'ru' as const },
  ];
  const paths = [];
  for (const { ver, lang } of BUILDS) {
    const actions = loadEntities(ver, lang, 'actions');
    const siblings = actions.map((a) => ({ slug: a.slug, name: a.name }));
    for (const entity of actions) {
      paths.push({ params: { lang, version: VERSION_SLUG[ver], slug: entity.slug }, props: { entity, ver, lang, siblings } });
    }
  }
  return paths;
}

const { entity, ver, lang, siblings } = Astro.props;
const verSlug = VERSION_SLUG[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);

const rawHtml = marked.parse(entity.description_md ?? '', { async: false });
const tree = fromHtml(rawHtml, { fragment: true });
autolinkTree(tree, { game: 'dnd', version: verSlug, lang, selfSlug: entity.slug });
const bodyHtml = toHtml(tree);
const description = excerpt(entity.description_md);
const source = sourceLinkFor(entity.description_md, { verSlug, lang });

const base = `/${lang}/dnd/${verSlug}/rules-glossary/action`;
const related = siblings.filter((s: { slug: string }) => s.slug !== entity.slug);
const upLink = { href: `/${lang}/dnd/${verSlug}/rules-glossary/`, ru: 'Глоссарий правил', en: 'Rules Glossary' };
const kind = t('Действие', 'Action');
const title = pageTitle({ name: entity.name, kind, lang, game: 'dnd', version: ver });
---

<ReaderShell
  contentSource={{ game: 'dnd', ver, lang, resource: 'actions' }}
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={entity.name}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <RulesTermEntry
    name={entity.name}
    nameEn={entity.name_en}
    lang={lang}
    bodyHtml={bodyHtml}
    source={source}
    related={related}
    relatedBase={base}
    relatedLabel={t('Другие действия', 'Other actions')}
  />
</ReaderShell>

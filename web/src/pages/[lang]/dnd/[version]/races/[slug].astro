---
import { marked } from 'marked';
import { fromHtml } from 'hast-util-from-html';
import { toHtml } from 'hast-util-to-html';
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { autolinkTree } from '../../../../../lib/rehype-entity-autolink.mjs';
import { highlightKeywords } from '../../../../../lib/keyword-highlight.mjs';
import { glossRules } from '../../../../../lib/rules-gloss.mjs';
import { loadEntities, excerpt, VERSION_SLUG } from '../../../../../lib/entities';
import { pageTitle } from '../../../../../lib/page-title';

// Programmatic-страницы рас (SRD 5.1). URL: /{lang}/dnd/{version}/races/{slug}/.
// EN и RU делят канонический (англ.) слаг → корректный hreflang. Родитель nav — глава «Расы».
// Расы есть только в 5.1 (в 5.2 — «Происхождение персонажа», отдельный ресурс, вне этого PR).
const PARENT_NAV: Record<string, string> = { srd51: 'd51-races-hub' };

interface Sub { slug: string; name: string; name_en?: string | null }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd51', lang: 'en' as const },
    { ver: 'srd51', lang: 'ru' as const },
  ];
  const paths = [];
  for (const { ver, lang } of BUILDS) {
    const races = loadEntities(ver, lang, 'races');
    const siblings = races.map((r) => ({ slug: r.slug, name: r.name }));
    for (const entity of races) {
      paths.push({
        params: { lang, version: VERSION_SLUG[ver], slug: entity.slug },
        props: { entity, ver, lang, siblings },
      });
    }
  }
  return paths;
}

const { entity, ver, lang, siblings } = Astro.props;
const verSlug = VERSION_SLUG[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);

// Тело расы (особенности + подрасы) с автоссылками/подсветкой: marked → hast → … → html.
const tree = fromHtml(marked.parse(entity.description_md ?? '', { async: false }), { fragment: true });
autolinkTree(tree, { game: 'dnd', version: verSlug, lang, selfSlug: entity.slug });
highlightKeywords(tree, { lang });
glossRules(tree, { game: 'dnd', version: verSlug, lang });
const bodyHtml = toHtml(tree);
const description = excerpt(entity.description_md as string);

const base = `/${lang}/dnd/${verSlug}/races`;
const subraces = (Array.isArray(entity.subraces) ? entity.subraces : []) as Sub[];
const related = (siblings as { slug: string; name: string }[]).filter((s) => s.slug !== entity.slug);

// Кнопка «в раздел» → хаб-справочник рас (список всех страниц рас).
const upLink = { href: `${base}/all/`, ru: 'Все расы', en: 'All races' };

const kind = t('Раса', 'Race');
const title = pageTitle({ name: entity.name, kind, lang, game: 'dnd', version: ver });
---

<ReaderShell
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={entity.name}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>
    {entity.name}
    {lang === 'ru' && entity.name_en && <span class="ent-en">{entity.name_en}</span>}
  </h1>

  {subraces.length > 0 && (
    <nav class="race-subraces" aria-label={t('Подрасы', 'Subraces')}>
      <span class="ent-related-h">{t('Подрасы', 'Subraces')}</span>
      <span class="ent-related-list">
        {subraces.map((s) => <span class="race-sub">{s.name}</span>)}
      </span>
    </nav>
  )}

  <Fragment set:html={bodyHtml} />

  {related.length > 0 && (
    <nav class="ent-related" aria-label={t('Другие расы', 'Other races')}>
      <span class="ent-related-h">{t('Другие расы', 'Other races')}</span>
      <span class="ent-related-list">
        {related.map((r) => (
          <a href={`${base}/${r.slug}/`}>{r.name}</a>
        ))}
      </span>
    </nav>
  )}
</ReaderShell>

<style>
  .ent-en {
    display: block; margin-top: 8px;
    font-family: var(--font-mono); font-size: 14px; font-weight: 400; letter-spacing: 0;
    color: var(--og-text-muted);
  }
  .race-subraces { display: block; margin: 0 0 24px; }
  .race-sub {
    display: inline-block; padding: 3px 10px; border: 1px solid var(--og-border); border-radius: 999px;
    font-size: 13px; color: var(--og-text-2); background: var(--og-bg-2);
  }
  .ent-related { display: block; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--og-border); }
  .ent-related-h {
    display: block; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;
    color: var(--og-text-muted); margin-bottom: 10px;
  }
  .ent-related-list { display: flex; flex-wrap: wrap; gap: 6px 14px; }
</style>

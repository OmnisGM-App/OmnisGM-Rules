---
import { marked } from 'marked';
import { fromHtml } from 'hast-util-from-html';
import { toHtml } from 'hast-util-to-html';
import ReaderShell from '../../../../../components/ReaderShell.astro';
import EntityHead from '../../../../../components/EntityHead.astro';
import { entityImage, ENTITY_IMAGE_SIZE } from '../../../../../lib/entity-image.mjs';
import { autolinkTree } from '../../../../../lib/rehype-entity-autolink.mjs';
import { loadEntities, excerpt, VERSION_SLUG } from '../../../../../lib/entities';
import { pageTitle } from '../../../../../lib/page-title';
import { gearDescription } from '../../../../../lib/entity-facts';
import { equipmentPath } from '../../../../../lib/equipment-path.mjs';

// Programmatic-страницы снаряжения (issue #20, Дорожка A) — зеркало страницы маг. предмета.
// URL: /{lang}/dnd/{version}/equipment/{slug}/ (глава 06_Equipment → /equipment/).
// Составная запись правил (#412) — группа: её страница остаётся на прежнем адресе и ведёт на свои
// предметы, а предмет группы живёт под ней: /equipment/musical-instrument/lute/.
// EN и RU делят канонический (англ.) слаг → корректный hreflang.
// Две секции: adventuring_gear (обычное снаряжение) и tools (инструменты — богаче стат-блок:
// связанная характеристика, действие «Использование», список изготавливаемого).
const PARENT_NAV: Record<string, string> = { srd52: 'd52-equipment', srd51: 'd51-equipment' };

// section (ключ по-английски в обеих локалях) → подпись.
const SECTION: Record<string, [string, string]> = {
  adventuring_gear: ['Снаряжение', 'Adventuring Gear'],
  tools: ['Инструменты', 'Tools'],
};

interface Sib { slug: string; name: string; section: string; path: string }
interface Member { name: string; path: string; cost: string; weight: string }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd52', lang: 'en' as const },
    { ver: 'srd52', lang: 'ru' as const },
    { ver: 'srd51', lang: 'en' as const },
    { ver: 'srd51', lang: 'ru' as const },
  ];
  const paths = [];
  for (const { ver, lang } of BUILDS) {
    const items = loadEntities(ver, lang, 'equipment');
    const groups = loadEntities(ver, lang, 'equipment-groups');
    const pathOf = (m: { slug: string; group?: unknown }) => equipmentPath({ slug: m.slug, group: m.group as string | null });
    // «Похожие» — без предметов групп: их соседи перечислены на странице группы.
    const siblings: Sib[] = [...items.filter((m) => !m.group), ...groups].map((m) => ({
      slug: m.slug, name: m.name, section: (m.section as string) ?? '', path: pathOf(m),
    }));
    // Карта «имя снаряжения (lowercase) → путь» — для линковки пунктов «Изготовление» на их страницы.
    const craftMap: Record<string, string> = {};
    for (const m of items) craftMap[m.name.toLowerCase()] = pathOf(m);
    const groupNames = Object.fromEntries(groups.map((g) => [g.slug, g.name]));
    for (const entity of items) {
      const group = entity.group ? { slug: entity.group as string, name: groupNames[entity.group as string] } : null;
      paths.push({
        params: { lang, version: VERSION_SLUG[ver], slug: pathOf(entity) },
        props: { entity, ver, lang, siblings, craftMap, group, members: [] as Member[] },
      });
    }
    for (const entity of groups) {
      const members: Member[] = items.filter((m) => m.group === entity.slug).map((m) => ({
        name: m.name, path: pathOf(m), cost: (m.cost as string) ?? '', weight: (m.weight as string) ?? '',
      }));
      paths.push({
        params: { lang, version: VERSION_SLUG[ver], slug: entity.slug },
        props: { entity, ver, lang, siblings, craftMap, group: null, members },
      });
    }
  }
  return paths;
}

const { entity, ver, lang, siblings, craftMap, group, members } = Astro.props;
// Группа — запись правил без цены и веса: вместо них перечень её предметов.
const isGroup = members.length > 0;
const verSlug = VERSION_SLUG[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);

// Тело с автоссылками на состояния/заклинания/монстров (issue #20): marked → hast → autolink → html.
const render = (md: string | undefined | null) => {
  if (!md || md === 'None') return '';
  const tree = fromHtml(marked.parse(md, { async: false }), { fragment: true });
  autolinkTree(tree, { game: 'dnd', version: verSlug, lang, selfSlug: entity.slug });
  return toHtml(tree);
};
const bodyHtml = render(entity.description_md as string);
// Сниппет из фактов (issue #185): цена и вес впереди — это и есть спрос по снаряжению
// («набор взломщика днд»), а excerpt() начинал сниппет с прозы. Откат — при отсутствии обоих.
// У группы цены нет: сниппет — её предметы с ценами, целыми пунктами в пределах лимита.
const groupDescription = () => {
  const head = `${entity.name} — ${t('снаряжение D&D 2024 (днд), виды и цены', 'D&D 2024 equipment, kinds and prices')}: `;
  const listed: string[] = [];
  for (const m of members as Member[]) {
    const next = [...listed, `${m.name} (${m.cost})`];
    if ((head + next.join(', ')).length > 154) break;
    listed.push(next[next.length - 1]);
  }
  const list = `${head}${listed.join(', ')}.`;
  // Короткий перечень (три символа веры) добирается началом текста группы.
  const room = 154 - list.length;
  return room >= 40 ? `${list} ${excerpt(entity.description_md as string, room)}` : list;
};
const description = isGroup
  ? groupDescription()
  : gearDescription({ entity, lang, version: ver }) ?? excerpt(entity.description_md as string);

const section = (entity.section as string) ?? '';
const sectionPair = SECTION[section];
const sectionLabel = sectionPair ? (lang === 'ru' ? sectionPair[0] : sectionPair[1]) : section;
const cost = (entity.cost as string) ?? '';
const weight = (entity.weight as string) ?? '';
const ability = (entity.ability as string) ?? '';
const utilize = (entity.utilize as string) ?? '';
const variants = (entity.variants as string) ?? '';
const craft = Array.isArray(entity.craft) ? (entity.craft as string[]) : [];

const base = `/${lang}/dnd/${verSlug}/equipment`;
// Пункт «Изготовление» → ссылка на страницу снаряжения, если slug найден.
const craftLink = (name: string) => {
  const path = craftMap[name.trim().toLowerCase()];
  return path ? `${base}/${path}/` : null;
};

// «Похожие» — предметы той же секции (внутренняя перелинковка/SEO).
const sameSection = (siblings as Sib[])
  .filter((s) => s.slug !== entity.slug && s.section === section)
  .slice(0, 8);

// Подстрока в шапке: секция · стоимость.
const subParts = [sectionLabel, cost].filter(Boolean);

// Предмет группы поднимается на страницу группы, остальное — в главу.
const upLink = group
  ? { href: `${base}/${group.slug}/`, ru: group.name, en: group.name }
  : { href: `${base}/`, ru: 'Снаряжение', en: 'Equipment' };
const kind = section === 'tools' ? t('Инструмент', 'Tool') : t('Снаряжение', 'Equipment');
const title = pageTitle({ name: entity.name, kind, lang, game: 'dnd', version: ver });
// Картинка сущности (#202): она же og:image страницы — вместо общего og.png.
// У предмета группы без своей картинки — картинка группы.
const icon = entityImage('dnd', 'gear', entity.slug) ?? (group ? entityImage('dnd', 'gear', group.slug) : null);
---

<ReaderShell
  contentSource={{ game: 'dnd', ver, lang, resource: 'equipment' }}
  entitySlug={isGroup ? undefined : entity.slug}
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={entity.name}
  description={description}
  headings={[]}
  image={icon ?? undefined}
  imageWidth={icon ? ENTITY_IMAGE_SIZE : undefined}
  imageHeight={icon ? ENTITY_IMAGE_SIZE : undefined}
  upLink={upLink}
>
  <EntityHead image={icon} alt={entity.name} size={ENTITY_IMAGE_SIZE}>
    <h1>
      {entity.name}
      <span class="ent-head-sub">
        {lang === 'ru' && entity.name_en && <span class="ent-en">{entity.name_en}</span>}
        {subParts.length > 0 && <span class="item-meta-line">{subParts.join(', ')}</span>}
      </span>
    </h1>
  </EntityHead>

  <dl class="item-stat">
    {sectionLabel && (
      <div class="item-row"><dt>{t('Категория', 'Category')}</dt><dd>{sectionLabel}</dd></div>
    )}
    {group && (
      <div class="item-row"><dt>{t('Группа', 'Group')}</dt>
        <dd><a class="ent-link" href={`${base}/${group.slug}/`}>{group.name}</a></dd></div>
    )}
    {cost && (
      <div class="item-row"><dt>{t('Стоимость', 'Cost')}</dt><dd>{cost}</dd></div>
    )}
    {weight && (
      <div class="item-row"><dt>{t('Вес', 'Weight')}</dt><dd>{weight}</dd></div>
    )}
    {ability && (
      <div class="item-row"><dt>{t('Характеристика', 'Ability')}</dt><dd>{ability}</dd></div>
    )}
    {utilize && (
      <div class="item-row"><dt>{t('Использование', 'Utilize')}</dt><dd>{utilize}</dd></div>
    )}
    {variants && (
      <div class="item-row"><dt>{t('Варианты', 'Variants')}</dt><dd>{variants}</dd></div>
    )}
    {craft.length > 0 && (
      <div class="item-row"><dt>{t('Изготовление', 'Craft')}</dt>
        <dd>{craft.map((c, i) => {
          const href = craftLink(c);
          return (
            <Fragment>{i > 0 ? ', ' : ''}{href
              ? <a class="ent-link" href={href}>{c}</a>
              : c}</Fragment>
          );
        })}</dd></div>
    )}
  </dl>

  {bodyHtml && <Fragment set:html={bodyHtml} />}

  {isGroup && (
    <table class="item-members" data-testid="equipment-group-items">
      <thead>
        <tr><th>{t('Предмет', 'Item')}</th><th>{t('Стоимость', 'Cost')}</th><th>{t('Вес', 'Weight')}</th></tr>
      </thead>
      <tbody>
        {members.map((m) => (
          <tr><td><a class="ent-link" href={`${base}/${m.path}/`}>{m.name}</a></td><td>{m.cost}</td><td>{m.weight || '—'}</td></tr>
        ))}
      </tbody>
    </table>
  )}

  {sameSection.length > 0 && (
    <nav class="ent-related" aria-label={t('Похожее снаряжение', 'Similar equipment')}>
      <span class="ent-related-h">{t(`Ещё: ${sectionLabel}`, `More ${sectionLabel}`)}</span>
      <span class="ent-related-list">
        {sameSection.map((r) => (
          <a href={`${base}/${r.path}/`}>{r.name}</a>
        ))}
      </span>
    </nav>
  )}
</ReaderShell>

<style>
  /* Подстрока в шапке: EN-имя + секция/стоимость. */
  .ent-head-sub {
    display: block; margin-top: 8px;
    font-family: var(--font-body); font-weight: 400; letter-spacing: 0;
  }
  .ent-en {
    font-family: var(--font-mono); font-size: 14px; font-weight: 400; letter-spacing: 0;
    color: var(--og-text-muted);
  }
  .item-meta-line { font-style: italic; font-size: 14px; color: var(--og-text-muted); }
  .ent-en + .item-meta-line::before { content: ' · '; font-style: normal; }

  .item-stat {
    margin: 0 0 24px; padding: 14px 16px; border: 1px solid var(--og-border); border-radius: 10px;
    background: var(--og-bg-2); display: grid; gap: 8px;
  }
  .item-row { display: grid; grid-template-columns: 160px 1fr; gap: 12px; align-items: baseline; }
  .item-row dt {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.6px; text-transform: uppercase;
    color: var(--og-text-muted); font-weight: 600;
  }
  .item-row dd { margin: 0; color: var(--og-text-2); }

  /* Предметы группы (#412): строка на предмет со ссылкой на его страницу. */
  .item-members { width: 100%; margin: 0 0 24px; border-collapse: collapse; }
  .item-members th, .item-members td { padding: 6px 10px; border-bottom: 1px solid var(--og-border); text-align: left; }
  .item-members th {
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.6px; text-transform: uppercase;
    color: var(--og-text-muted); font-weight: 600;
  }

  .ent-related { display: block; margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--og-border); }
  .ent-related-h {
    display: block; font-size: 13px; text-transform: uppercase; letter-spacing: 1px;
    color: var(--og-text-muted); margin-bottom: 10px;
  }
  .ent-related-list { display: flex; flex-wrap: wrap; gap: 6px 14px; }

  @media (max-width: 560px) {
    .item-row { display: block; }
    .item-row dt { display: inline; }
    .item-row dt::after { content: ':\00a0'; }
    .item-row dd { display: inline; }
  }
</style>

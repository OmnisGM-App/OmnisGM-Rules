---
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../lib/entities';
import { pageTitle } from '../../../../../lib/page-title';

// Хаб-справочник происхождений (SRD 5.2): /{lang}/dnd/{version}/character-origins/all/.
// Групповая страница со ссылками на все виды и предыстории. Точка входа в entity-страницы.
const PARENT_NAV: Record<string, string> = { srd52: 'd52-origins-hub' };

interface Ent { slug: string; name: string; name_en?: string | null }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd52', lang: 'en' as const },
    { ver: 'srd52', lang: 'ru' as const },
  ];
  return BUILDS.map(({ ver, lang }) => ({
    params: { lang, version: VERSION_SLUG[ver] },
    props: {
      ver, lang,
      species: loadEntities(ver, lang, 'species') as unknown as Ent[],
      backgrounds: loadEntities(ver, lang, 'backgrounds') as unknown as Ent[],
    },
  }));
}

const { ver, lang, species, backgrounds } = Astro.props as {
  ver: string; lang: 'en' | 'ru'; species: Ent[]; backgrounds: Ent[];
};
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);

const heading = t('Виды и предыстории', 'Species & Backgrounds');
const title = pageTitle({ name: heading, lang, game: 'dnd', version: ver });
const description = t(
  `Все виды (${species.length}) и предыстории (${backgrounds.length}) D&D ${verLabel} со ссылками на страницы: черты вида, характеристики и умения предыстории.`,
  `All ${species.length} species and ${backgrounds.length} backgrounds of D&D ${verLabel} with links to each page.`,
);
const upLink = { href: `/${lang}/dnd/${verSlug}/character-origins/`, ru: 'Происхождение (глава)', en: 'Character Origins (chapter)' };

// Единая таблица: вид/предыстория помечены колонкой «Тип» — так строки сортируются вместе
// (по имени / по типу), а не двумя раздельными списками.
const rows = [
  ...species.map((e) => ({ ...e, dir: 'species', kind: t('Вид', 'Species') })),
  ...backgrounds.map((e) => ({ ...e, dir: 'backgrounds', kind: t('Предыстория', 'Background') })),
];
---

<ReaderShell
  contentSource={{ game: 'dnd', ver, lang, resource: 'species' }}
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `Виды и предыстории D&D ${verLabel}. Нажмите, чтобы открыть страницу. Общие правила происхождения — в главе «Происхождение персонажа».`,
      `Species and backgrounds of D&D ${verLabel}. Select one to open its page. General origin rules are in the Character Origins chapter.`,
    )}
  </p>

  <div class="rd-table-wrap">
    <table class="hub-table" data-sortable>
      <thead>
        <tr>
          <th>{t('Название', 'Name')}</th><th>{t('Тип', 'Kind')}</th>
          {lang === 'ru' && <th>Оригинал</th>}
        </tr>
      </thead>
      <tbody>
        {rows.map((e) => (
          <tr>
            <td><a href={`/${lang}/dnd/${verSlug}/${e.dir}/${e.slug}/`}>{e.name}</a></td>
            <td>{e.kind}</td>
            {lang === 'ru' && <td class="og-en">{e.name_en ?? '—'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</ReaderShell>

<style>
  .og-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
</style>

---
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../lib/entities';

// Хаб-справочник навыков (BRP SRD 1.0): /{lang}/brp/{version}/skills/all/.
// Сгруппирован по 6 категориям + джамп-нав на by-category фасеты. Статический `all` > `[slug]`.
const GAME = 'brp';
const PARENT_NAV: Record<string, string> = { srd10: 'brp-skills-hub' };
const CATS = ['combat', 'communication', 'manipulation', 'mental', 'perception', 'physical'];

interface Skill { slug: string; name: string; name_en?: string | null; base_chance?: string; category?: string; category_slug?: string }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  return BUILDS.map(({ ver, lang }) => ({
    params: { lang, version: VERSION_SLUG[ver] },
    props: { ver, lang, skills: loadEntities(ver, lang, 'skills', 'brp') as unknown as Skill[] },
  }));
}

const { ver, lang, skills } = Astro.props as { ver: string; lang: 'en' | 'ru'; skills: Skill[] };
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);
const base = `/${lang}/${GAME}/${verSlug}/skills`;

// Группировка по категории в фиксированном порядке; отображаемое имя — из первой карточки.
const byCat = CATS.map((cs) => ({
  slug: cs,
  name: skills.find((s) => s.category_slug === cs)?.category ?? cs,
  items: skills.filter((s) => s.category_slug === cs).sort((a, b) => a.name.localeCompare(b.name)),
})).filter((g) => g.items.length);

const heading = t('Навыки', 'Skills');
const title = `${heading} — Basic Roleplaying ${verLabel} · OmnisGM Rules`;
const description = t(
  `Все ${skills.length} навыков Basic Roleplaying ${verLabel} по 6 категориям: базовый шанс и описание каждого.`,
  `All ${skills.length} Basic Roleplaying ${verLabel} skills across 6 categories with base chance and description.`,
);
const upLink = { href: `/${lang}/${GAME}/${verSlug}/09_Glossary/01_Skills/`, ru: 'Навыки (глава)', en: 'Skills (chapter)' };
---

<ReaderShell
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `${skills.length} навыков Basic Roleplaying ${verLabel} по категориям. Нажмите на навык, чтобы открыть его страницу.`,
      `${skills.length} Basic Roleplaying ${verLabel} skills by category. Select a skill to open its page.`,
    )}
  </p>

  <nav class="og-jump" aria-label={t('Категории', 'Categories')}>
    {byCat.map((g) => <a href={`${base}/category/${g.slug}/`}>{g.name}</a>)}
  </nav>

  {byCat.map((g) => (
    <section class="og-group">
      <h2>{g.name}</h2>
      <ul class="og-grid">
        {g.items.map((s) => (
          <li class="og-card">
            <a class="og-card-link" href={`${base}/${s.slug}/`}>{s.name}</a>
            {lang === 'ru' && s.name_en && <span class="og-card-en">{s.name_en}</span>}
            {s.base_chance && <span class="og-card-sub">{s.base_chance}</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</ReaderShell>

<style>
  .og-jump { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 20px 0 8px; }
  .og-group { margin-top: 28px; }
  .og-grid {
    list-style: none; margin: 14px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;
  }
  .og-card {
    display: flex; flex-direction: column; gap: 3px;
    padding: 14px 16px; border: 1px solid var(--og-border); border-radius: 10px;
    background: var(--og-bg-2);
  }
  .og-card-link { font-weight: 600; font-size: 16px; }
  .og-card-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
  .og-card-sub { font-size: 13px; color: var(--og-text-2); }
</style>

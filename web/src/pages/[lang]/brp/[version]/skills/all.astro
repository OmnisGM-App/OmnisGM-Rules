---
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../lib/entities';

// Хаб-справочник навыков (BRP SRD 1.0): /{lang}/brp/{version}/skills/all/.
// Единая сортируемая таблица (навык · категория · базовый шанс); «Категория» → фасет. `all` > `[slug]`.
const GAME = 'brp';
const PARENT_NAV: Record<string, string> = { srd10: 'brp-skills-hub' };
const CATS = ['combat', 'communication', 'manipulation', 'mental', 'perception', 'physical'];

interface Skill { slug: string; name: string; name_en?: string | null; base_chance?: string; category?: string; category_slug?: string }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  return BUILDS.map(({ ver, lang }) => ({
    params: { lang, version: VERSION_SLUG[ver] },
    props: { ver, lang, skills: loadEntities(ver, lang, 'skills', 'brp') as unknown as Skill[] },
  }));
}

const { ver, lang, skills } = Astro.props as { ver: string; lang: 'en' | 'ru'; skills: Skill[] };
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);
const base = `/${lang}/${GAME}/${verSlug}/skills`;

const sorted = skills.slice().sort((a, b) => a.name.localeCompare(b.name));
// Категории (фикс. порядок), реально присутствующие, + локализованное имя — для футер-навигации.
const catList = CATS
  .map((cs) => {
    const sample = skills.find((s) => s.category_slug === cs);
    return sample?.category ? { slug: cs, name: sample.category } : null;
  })
  .filter((c): c is { slug: string; name: string } => c !== null);
// Базовый шанс «25%» → 25 для числовой сортировки (−1, если нет).
const chanceOrder = (raw?: string) => { const n = raw ? parseInt(raw, 10) : NaN; return Number.isNaN(n) ? -1 : n; };

const heading = t('Навыки', 'Skills');
const title = `${heading} — Basic Roleplaying ${verLabel} · OmnisGM Rules`;
const description = t(
  `Все ${skills.length} навыков Basic Roleplaying ${verLabel} по 6 категориям: базовый шанс и описание каждого.`,
  `All ${skills.length} Basic Roleplaying ${verLabel} skills across 6 categories with base chance and description.`,
);
const upLink = { href: `/${lang}/${GAME}/${verSlug}/09_Glossary/01_Skills/`, ru: 'Навыки (глава)', en: 'Skills (chapter)' };
---

<ReaderShell
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `${skills.length} навыков Basic Roleplaying ${verLabel}. В таблице — категория (ссылка на список категории) и базовый шанс. Нажмите на заголовок столбца, чтобы отсортировать.`,
      `${skills.length} Basic Roleplaying ${verLabel} skills. The table lists category (linked to its list) and base chance. Click a column header to sort.`,
    )}
  </p>

  <div class="rd-table-wrap">
    <table class="hub-table" data-sortable>
      <thead>
        <tr>
          <th>{t('Навык', 'Skill')}</th><th>{t('Категория', 'Category')}</th>
          <th>{t('Баз. шанс', 'Base %')}</th>{lang === 'ru' && <th>Оригинал</th>}
        </tr>
      </thead>
      <tbody>
        {sorted.map((s) => (
          <tr>
            <td><a href={`${base}/${s.slug}/`}>{s.name}</a></td>
            <td>{s.category_slug ? <a href={`${base}/category/${s.category_slug}/`}>{s.category}</a> : (s.category ?? '—')}</td>
            <td data-sort={chanceOrder(s.base_chance)}>{s.base_chance ?? '—'}</td>
            {lang === 'ru' && <td class="og-en">{s.name_en ?? '—'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <nav class="hub-links" aria-label={t('Навыки по категории', 'Skills by category')}>
    <p><strong>{t('По категории:', 'By category:')}</strong>{' '}
      {catList.map((c, i) => (
        <>{i > 0 ? ' · ' : ''}<a href={`${base}/category/${c.slug}/`}>{c.name}</a></>
      ))}
    </p>
  </nav>
</ReaderShell>

<style>
  .og-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
</style>

---
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../lib/entities';

// Хаб-справочник точечных правил (BRP SRD 1.0): /{lang}/brp/{version}/spot-rules/all/.
const GAME = 'brp';
const PARENT_NAV: Record<string, string> = { srd10: 'brp-spotrules-hub' };

interface Ent { slug: string; name: string; name_en?: string | null }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  return BUILDS.map(({ ver, lang }) => ({
    params: { lang, version: VERSION_SLUG[ver] },
    props: { ver, lang, items: loadEntities(ver, lang, 'spot-rules', 'brp') as unknown as Ent[] },
  }));
}

const { ver, lang, items } = Astro.props as { ver: string; lang: 'en' | 'ru'; items: Ent[] };
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);
const base = `/${lang}/${GAME}/${verSlug}/spot-rules`;

const heading = t('Точечные правила', 'Spot Rules');
const title = `${heading} — Basic Roleplaying ${verLabel} · OmnisGM Rules`;
const description = t(
  `Все ${items.length} точечных правил Basic Roleplaying ${verLabel}: засада, укрытие, падение, погоня и другие ситуативные правила.`,
  `All ${items.length} Basic Roleplaying ${verLabel} spot rules: ambush, cover, falling, chases and other situational rules.`,
);
const upLink = { href: `/${lang}/${GAME}/${verSlug}/06_SpotRules/`, ru: 'Точечные правила (глава)', en: 'Spot Rules (chapter)' };
---

<ReaderShell
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `${items.length} точечных правил Basic Roleplaying ${verLabel}. Нажмите, чтобы открыть страницу правила.`,
      `${items.length} Basic Roleplaying ${verLabel} spot rules. Select one to open its page.`,
    )}
  </p>

  <ul class="og-grid">
    {items.map((r) => (
      <li class="og-card">
        <a class="og-card-link" href={`${base}/${r.slug}/`}>{r.name}</a>
        {lang === 'ru' && r.name_en && <span class="og-card-en">{r.name_en}</span>}
      </li>
    ))}
  </ul>
</ReaderShell>

<style>
  .og-grid {
    list-style: none; margin: 24px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;
  }
  .og-card {
    display: flex; flex-direction: column; gap: 3px;
    padding: 14px 16px; border: 1px solid var(--og-border); border-radius: 10px;
    background: var(--og-bg-2);
  }
  .og-card-link { font-weight: 600; font-size: 16px; }
  .og-card-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
</style>

---
import ReaderShell from '../../../../../components/ReaderShell.astro';
import { loadEntities, VERSION_SLUG, VERSION_LABEL } from '../../../../../lib/entities';
import { pageTitle } from '../../../../../lib/page-title';

// Хаб-справочник точечных правил (BRP SRD 1.0): /{lang}/brp/{version}/spot-rules/all/.
const GAME = 'brp';
const PARENT_NAV: Record<string, string> = { srd10: 'brp-spotrules-hub' };

interface Ent { slug: string; name: string; name_en?: string | null }

export function getStaticPaths() {
  const BUILDS = [
    { ver: 'srd10', lang: 'en' as const },
    { ver: 'srd10', lang: 'ru' as const },
  ];
  return BUILDS.map(({ ver, lang }) => ({
    params: { lang, version: VERSION_SLUG[ver] },
    props: {
      ver, lang,
      items: (loadEntities(ver, lang, 'spot-rules', 'brp') as unknown as Ent[])
        .slice().sort((a, b) => a.name.localeCompare(b.name)),
    },
  }));
}

const { ver, lang, items } = Astro.props as { ver: string; lang: 'en' | 'ru'; items: Ent[] };
const verSlug = VERSION_SLUG[ver];
const verLabel = VERSION_LABEL[ver];
const t = (ru: string, en: string) => (lang === 'ru' ? ru : en);
const base = `/${lang}/${GAME}/${verSlug}/spot-rules`;

const heading = t('Точечные правила', 'Spot Rules');
// Хаб — полный список; MD-глава того же раздела зовётся так же, поэтому в
// <title> отличаем их словом «Все …» (H1 не трогаем).
const title = pageTitle({ name: t('Все точечные правила', 'All Spot Rules'), lang, game: 'brp', version: ver });
const description = t(
  `Все ${items.length} точечных правил Basic Roleplaying ${verLabel}: засада, укрытие, падение, погоня и другие ситуативные правила.`,
  `All ${items.length} Basic Roleplaying ${verLabel} spot rules: ambush, cover, falling, chases and other situational rules.`,
);
const upLink = { href: `/${lang}/${GAME}/${verSlug}/06_SpotRules/`, ru: 'Точечные правила (глава)', en: 'Spot Rules (chapter)' };
---

<ReaderShell
  contentSource={{ game: 'brp', ver, lang, resource: 'spot-rules' }}
  lang={lang}
  currentId={PARENT_NAV[ver]}
  title={title}
  searchTitle={heading}
  description={description}
  headings={[]}
  upLink={upLink}
>
  <h1>{heading}</h1>
  <p>
    {t(
      `${items.length} точечных правил Basic Roleplaying ${verLabel}. Нажмите на название, чтобы открыть страницу правила.`,
      `${items.length} Basic Roleplaying ${verLabel} spot rules. Select a name to open its page.`,
    )}
  </p>

  <div class="rd-table-wrap">
    <table class="hub-table" data-sortable>
      <thead>
        <tr><th>{t('Правило', 'Rule')}</th>{lang === 'ru' && <th>Оригинал</th>}</tr>
      </thead>
      <tbody>
        {items.map((r) => (
          <tr>
            <td><a href={`${base}/${r.slug}/`}>{r.name}</a></td>
            {lang === 'ru' && <td class="og-en">{r.name_en ?? '—'}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</ReaderShell>

<style>
  .og-en { font-family: var(--font-mono); font-size: 13px; color: var(--og-text-muted); }
</style>

{
  // Проверка типов для JS вне сборки Astro (#285, #304). Разграничение с `astro check`
  // проверено прогонами, а не предположением: `web/tsconfig.json` включает `**/*`, поэтому
  // `.ts` — конфиг Playwright и все e2e-спеки — он уже читает (заведомая ошибка типа в
  // `reader.spec.ts` краснит `npm run check`). А вот `.mjs` он не смотрит вовсе: та же ошибка
  // в `add_sitemap_lastmod.mjs` оставляет его зелёным. Новое покрытие здесь — `checkJs`;
  // `.ts` включены, чтобы одна программа охватывала весь слой (ревью #298).
  //
  // Покрытие ПОЛНОЕ по классу: весь `web/scripts`, весь `web/src/lib`, `astro.config.mjs`,
  // корневые `scripts/*.mjs` и e2e. Первая пачка (#285) брала восемь скриптов из четырнадцати
  // и честно называла остаток; вторая (#304) остаток закрыла, поэтому оговорки о частичном
  // покрытии здесь больше нет — и появиться снова она может только с явной правкой этого
  // файла. Заодно исчезла старая ловушка «границы»: первый `import` из `web/src/lib` затягивал
  // цель под `checkJs` без правки конфига, и `lint:tools` мог покраснеть от чужого импорта —
  // теперь тянуть неоткуда, всё уже внутри.
  //
  // Цена дыры разная у разных файлов, и стоит её различать: `cf_purge_urls.mjs` и
  // `indexnow_manifest.mjs` ломаются ТИХО — порогов осмысленности результата в них нет,
  // сброшенный не тот кэш и пинг не тех URL никто не заметит. `add_sitemap_lastmod.mjs`
  // и гейты по `dist` громкие сами по себе (`process.exit(1)` по структуре и долям), и tsc
  // страхует у них не структуру, а опечатку в имени поля. А `web/src/lib` — вообще не
  // инструменты: шесть из тринадцати файлов стоят rehype-цепочкой в `astro.config.mjs`, то
  // есть решают, какой HTML получат 6000 страниц, и до #304 не проверялись ничем.
  //
  // Донор — `news/tsconfig.tools.json` (#63) вместе с его уроком: маска `scripts/**` затянула
  // бы транзитивные импорты и утопила первый заход в сотнях TS7006, поэтому состав явный.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "strict": true,
    // `astro.config.mjs` импортирует `./e2e/ports.ts` с расширением — так его резолвит Vite.
    // Без этой опции tsc валит TS5097 на верном коде; эмита у нас нет, менять пути не нужно.
    "allowImportingTsExtensions": true,
    // Скрипты — .mjs: без `allowJs` TypeScript не заглянул бы в них вовсе, а с `checkJs`
    // проверяется и то, что ВНУТРИ них, а не только их импорт у потребителя.
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  // Отдельные файлы — в `files`, а НЕ в `include`: в `include` записи это глобы, и запись, не
  // совпавшая ни с одним файлом, молчит. Переименуй `cf_purge_urls.mjs` — деплой-критичный
  // скрипт выпал бы из-под проверки, а `lint:tools` остался зелёным. В `files`
  // непокрытая запись даёт `TS6053: File not found` (ревью #298).
  "files": [
    "astro.config.mjs",
    "scripts/add_sitemap_lastmod.mjs",
    "scripts/build_fingerprint.mjs",
    "scripts/cf_purge_urls.mjs",
    "scripts/check_csp.mjs",
    "scripts/copy-brand-assets.mjs",
    "scripts/gen-content-dates.mjs",
    "scripts/gen-entity-data.mjs",
    "scripts/indexnow_manifest.mjs",
    "scripts/test_build_fingerprint.mjs",
    "scripts/test_page_description.mjs",
    "scripts/test_plural.mjs",
    "scripts/verify_dist_meta_budget.mjs",
    "scripts/verify_dist_seo.mjs",
    "scripts/verify_no_hardcoded_urls.mjs",
    "../scripts/gen-images.mjs",
    "../scripts/install_hooks.mjs",
    "../scripts/test_gen_images_kind.mjs",
    "../scripts/test_unit_agenda.mjs",
    "../scripts/test_workflow_setup.mjs"
  ],
  // …а e2e и `src/lib` — масками: спеков 35 (плюс `global-setup.ts` и `ports.ts` — не спеки,
  // но той же маски), файлы `src/lib` тоже приходят и уходят пачками, и требовать поимённого
  // списка здесь значило бы ломать гейт на каждом новом файле. Риск «молчащей записи» тут
  // другой: он был бы у ОДИНОЧНОГО файла, а пустеющий каталог виден и без tsc.
  "include": ["playwright.config.ts", "e2e/**/*.ts", "src/lib/**/*.mjs"]
}

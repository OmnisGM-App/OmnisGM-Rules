{
  "name": "omnisgm-rules-web",
  "version": "0.1.0",
  "engines": {
    "node": "^20.19.5 || >=22.12.0"
  },
  "private": true,
  "type": "module",
  "description": "rules.omnisgm.com — Astro (SSG) SRD reader for the OmnisGM ecosystem",
  "scripts": {
    "predev": "node scripts/copy-brand-assets.mjs && node scripts/gen-entity-data.mjs && node scripts/gen-content-dates.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-brand-assets.mjs && node scripts/gen-entity-data.mjs && node scripts/gen-content-dates.mjs && node scripts/build_fingerprint.mjs --stash",
    "build": "astro build",
    "postbuild": "node scripts/add_sitemap_lastmod.mjs && node scripts/build_fingerprint.mjs --commit",
    "preview": "astro preview",
    "check": "astro check",
    "lint:tools": "tsc -p tsconfig.tools.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --project=mobile --project=webkit-mobile",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@omnisgm-app/brand": "^0.9.0",
    "@omnisgm-app/core": "^0.2.0",
    "astro": "^5.7.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-html": "^9.0.5",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.4.1",
    "@vite-pwa/astro": "^1.2.0",
    "astro-pagefind": "^1.8.0",
    "typescript": "^6.0.3"
  }
}
